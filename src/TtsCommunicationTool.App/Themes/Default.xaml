<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Default Dark (Catppuccin Mocha) theme.
        All brushes here are replaced at runtime by ThemeService.Apply().
        DynamicResource bindings throughout the app pick up changes automatically.

        Key naming convention:
          Colour role   → {RoleName}Brush    (SolidColorBrush)
          Raw colour    → {RoleName}Color    (Color — added by ThemeService for special cases)
    -->

    <!-- Core backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#1E1E2E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"     Color="#2B2B3D"/>
    <SolidColorBrush x:Key="DeepPanelBackgroundBrush" Color="#181825"/>
    <SolidColorBrush x:Key="HistoryBackgroundBrush"   Color="#14141E"/>
    <SolidColorBrush x:Key="Surface0Brush"            Color="#313244"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="#45475A"/>
    <SolidColorBrush x:Key="Surface2Brush"            Color="#585B70"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"              Color="#89B4FA"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="#B4D0FB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="#CDD6F4"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="#A6ADC8"/>
    <SolidColorBrush x:Key="MutedTextBrush"           Color="#6C7086"/>
    <SolidColorBrush x:Key="MutedIconBrush"           Color="#8B9CC8"/>

    <!-- Status -->
    <SolidColorBrush x:Key="InfoBrush"                Color="#FAB387"/>
    <SolidColorBrush x:Key="ErrorBrush"               Color="#F38BA8"/>
    <SolidColorBrush x:Key="ErrorHoverBrush"          Color="#F5A0B5"/>
    <SolidColorBrush x:Key="WarningBrush"             Color="#F9E2AF"/>
    <SolidColorBrush x:Key="SuccessBrush"             Color="#A6E3A1"/>

    <!-- Raw Color values (used where a Color — not a Brush — is required, e.g. overlay opacity) -->
    <Color x:Key="WindowBackgroundColor">#1E1E2E</Color>

</ResourceDictionary>
