<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TtsCommunicationTool.App</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Splashscreen.png" Link="Splashscreen.png" />
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TtsCommunicationTool.UI\TtsCommunicationTool.UI.csproj" />
    <ProjectReference Include="..\TtsCommunicationTool.Core\TtsCommunicationTool.Core.csproj" />
    <ProjectReference Include="..\TtsCommunicationTool.Infrastructure\TtsCommunicationTool.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="PublishSapi5Bridge" AfterTargets="Build">
    <MSBuild Projects="..\TtsCommunicationTool.Sapi5Bridge\TtsCommunicationTool.Sapi5Bridge.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0-windows\sapi5-bridge-publish\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0-windows\sapi5-bridge-publish\TtsCommunicationTool.Sapi5Bridge.exe"
          DestinationFolder="$(TargetDir)" />
  </Target>

</Project>
