<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TtsCommunicationTool.App</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.17.0</Version>
    <AssemblyVersion>0.17.0.0</AssemblyVersion>
    <FileVersion>0.17.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Splashscreen.png" Link="Splashscreen.png" />
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TtsCommunicationTool.UI\TtsCommunicationTool.UI.csproj" />
    <ProjectReference Include="..\TtsCommunicationTool.Core\TtsCommunicationTool.Core.csproj" />
    <ProjectReference Include="..\TtsCommunicationTool.Infrastructure\TtsCommunicationTool.Infrastructure.csproj" />
  </ItemGroup>

</Project>
