<Window x:Class="TtsCommunicationTool.UI.Views.ImportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Background="#1E1E2E"
            CornerRadius="10"
            BorderBrush="#45475A"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" Opacity="0.65" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel Margin="28,24,28,24">

            <!-- Header -->
            <TextBlock Text="Import Complete"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#CDD6F4"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,16"/>

            <!-- Stat rows -->
            <TextBlock x:Name="AddedText"
                       Foreground="#A6E3A1"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="NamesText"
                       Foreground="#89B4FA"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,5"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="HotkeysText"
                       Foreground="#FAB387"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"/>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,14" x:Name="CacheSeparator" Visibility="Collapsed"/>

            <!-- Caching section -->
            <TextBlock x:Name="CachingHeaderText"
                       Foreground="#6C7086"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <Grid x:Name="ProgressGrid" Visibility="Collapsed" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="CacheProgressBar"
                             Grid.Column="0"
                             Minimum="0"
                             Height="8"
                             VerticalAlignment="Center"
                             Background="#313244"
                             Foreground="#89B4FA"/>
                <TextBlock x:Name="CacheStatusText"
                           Grid.Column="1"
                           Foreground="#6C7086"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- OK Button -->
            <Button x:Name="OkButton"
                    Content="OK"
                    IsEnabled="False"
                    Click="OkButton_Click"
                    HorizontalAlignment="Right"
                    Width="80" Height="32"
                    Margin="0,16,0,0"
                    FontFamily="Segoe UI"
                    FontSize="13">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#89B4FA" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#1E1E2E"
                                       FontSize="13"
                                       FontFamily="Segoe UI"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B4D0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>
