<Window x:Class="TtsCommunicationTool.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TtsCommunicationTool.UI.Converters"
        Title="TTS Overlay"
        Width="720" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="OverlayWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="OverlayWindow_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <converters:StatusSeverityToColorConverter x:Key="StatusSeverityColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibleConverter"/>
    </Window.Resources>

    <Border x:Name="OverlayBorder"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="8">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}" Opacity="0.93"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.55" ShadowDepth="3"/>
        </Border.Effect>

        <!-- Two-row layout: input area + seamless status bar -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Input area -->
            <Grid Grid.Row="0" Margin="14,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Input TextBox -->
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{Binding MaxLength}"
                         FontSize="{DynamicResource OverlayFontSizeResource}"
                         FontFamily="{DynamicResource OverlayFontFamilyResource}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource AccentBrush}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden"
                         VerticalContentAlignment="Top"
                         Padding="4,4">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Send Button -->
                <Button Grid.Column="1"
                        Click="SendButton_Click"
                        IsEnabled="{Binding CanSubmit}"
                        Width="48" Height="36"
                        Margin="10,0,0,0"
                        Cursor="Hand"
                        ToolTip="Send (Enter) — Ctrl+Enter to stop current audio and send">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="8"
                                    Padding="10,6">
                                <TextBlock Text="&#x25B6;"
                                           FontSize="14"
                                           Foreground="{DynamicResource WindowBackgroundBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Seamless status bar strip -->
            <Border Grid.Row="1"
                    Background="{DynamicResource HistoryBackgroundBrush}"
                    CornerRadius="0,0,10,10"
                    Padding="16,5,16,7">
                <DockPanel LastChildFill="True">
                    <!-- Resend last message button -->
                    <Button DockPanel.Dock="Right"
                            x:Name="ResendButton"
                            Click="ResendButton_Click"
                            Cursor="Hand"
                            ToolTip="Resend last message"
                            Width="Auto" Height="16"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanResend}"
                            Visibility="{Binding HasRecentMessage, Converter={StaticResource BoolToVisConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ResendBorder" Background="Transparent">
                                    <TextBlock x:Name="ResendText"
                                               Text="↩ Resend"
                                               FontSize="11"
                                               FontFamily="Segoe UI"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Disabled: audio is already playing — dim to match blocked-send visual -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ResendText" Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                    </Trigger>
                                    <!-- Hover only when enabled -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsEnabled" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="ResendText" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Gear button — opens settings, far right -->
                    <Button DockPanel.Dock="Right"
                            x:Name="GearButton"
                            Click="GearButton_Click"
                            Cursor="Hand"
                            ToolTip="Open Settings"
                            Width="16" Height="16"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="IconBorder" Background="Transparent">
                                    <TextBlock x:Name="GearIcon"
                                               Text="&#x2699;"
                                               FontSize="14"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.ClearTypeHint="Enabled"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GearIcon" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Char counter — right side, most muted -->
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CharacterCountDisplay}"
                               VerticalAlignment="Center"
                               Foreground="#45475A"
                               FontSize="11"
                               FontFamily="Segoe UI"/>
                    <!-- ElevenLabs credit estimate — right of char counter, only visible when ElevenLabs active -->
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding EstimatedCreditDisplay}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               Margin="0,0,8,0"
                               ToolTip="Estimated ElevenLabs characters that will be consumed from your quota."
                               Visibility="{Binding EstimatedCreditDisplay,
                                   Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                    <!-- Status text — left, colour driven by severity -->
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{Binding StatusSeverity, Converter={StaticResource StatusSeverityColorConverter}}"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
