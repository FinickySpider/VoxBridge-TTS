<Window x:Class="TtsCommunicationTool.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TtsCommunicationTool.UI.ViewModels"
        xmlns:conv="clr-namespace:TtsCommunicationTool.UI.Converters"
        Title="Settings — TTS Communication Tool v0.9.1"
        Width="680" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibleConverter"/>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibleConverter"/>
        <conv:HotkeyBindingDisplayConverter x:Key="HotkeyDisplayConverter"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Shared styles for dark-themed controls -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#89B4FA"/>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#2B2B3D"/>
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#6C7086"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2B2B3D"
                                            BorderBrush="#45475A"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B4D0FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5A0B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="12,12,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#6C7086"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B2B3D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding General.StartWithWindows}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show toast notifications"
                                  IsChecked="{Binding General.ShowNotifications}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show splash screen on startup"
                                  IsChecked="{Binding General.ShowSplashScreen}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Transcript" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Log spoken messages to transcript file"
                                  IsChecked="{Binding General.EnableTranscriptLogging}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <TextBlock Text="Saves every sent message with a timestamp to a plain text file in your AppData folder."
                                   Foreground="#6C7086" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Button Content="Open Transcript File"
                                Command="{Binding General.OpenTranscriptCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Keep unsent text when overlay closes"
                                  IsChecked="{Binding General.KeepOverlayText}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <TextBlock Text="When enabled, any text typed but not sent will be restored the next time you open the overlay."
                                   Foreground="#6C7086" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Message Length" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Limit message length"
                                  IsChecked="{Binding General.EnableCharacterLimit}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <Grid Margin="0,4,0,0"
                              IsEnabled="{Binding General.EnableCharacterLimit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum characters:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding General.MaxOverlayInputLength, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>
                        <TextBlock Text="Controls the character limit displayed on the overlay input field. When off, only character count is shown."
                                   Foreground="#6C7086" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Click a field, then press the desired key combination. Esc clears a binding."
                                   Foreground="#6C7086" FontSize="12" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Toggle Overlay:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="OverlayHotkeyBox"
                                     Text="{Binding Hotkeys.OverlayHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Click here then press any key combination to set the overlay toggle hotkey."
                                     PreviewKeyDown="OverlayHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop Playback:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="StopHotkeyBox"
                                     Text="{Binding Hotkeys.StopHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Click here then press any key combination to set the stop-playback hotkey."
                                     PreviewKeyDown="StopHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Open Settings:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="SettingsHotkeyBox"
                                     Text="{Binding Hotkeys.SettingsHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Click here then press any key combination to set the open-settings hotkey. Optional — leave as (none) to disable."
                                     PreviewKeyDown="SettingsHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resend Last:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="ResendHotkeyBox"
                                     Text="{Binding Hotkeys.ResendHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Click here then press any key combination to set the resend-last-message hotkey. Optional — leave as (none) to disable."
                                     PreviewKeyDown="ResendHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <TextBlock Text="{Binding Hotkeys.ValidationMessage}"
                                   Foreground="#F38BA8" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Audio Devices" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor (You):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedMonitorDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The audio device you hear yourself on (headphones, speakers, etc.)."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary (App):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedSecondaryDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The secondary output device (VB-Cable, virtual audio cable for Discord/VRChat, etc.)."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Test Monitor" Command="{Binding Audio.TestMonitorCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Secondary" Command="{Binding Audio.TestSecondaryCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Both" Command="{Binding Audio.TestBothCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="↻ Refresh" Command="{Binding Audio.RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Audio.DeviceWarning}"
                                   Foreground="#FAB387" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="Volume" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>

                        <!-- Monitor Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.MonitorVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="#CDD6F4" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.MonitorVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Secondary Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.SecondaryVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="#CDD6F4" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.SecondaryVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Voice Tab -->
            <TabItem Header="Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Voice Engine" Style="{StaticResource SectionHeader}"/>

                        <!-- Engine selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="Kokoro (Offline)"
                                         Foreground="#CDD6F4" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsKokoro, Mode=TwoWay}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="ElevenLabs (Online)"
                                         Foreground="#CDD6F4" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsElevenLabs, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- ── Kokoro section ───────────────── -->
                        <StackPanel Visibility="{Binding Voice.IsKokoro, Converter={StaticResource BoolToVisConverter}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.AvailableVoices}"
                                          SelectedValue="{Binding Voice.SelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"/>
                            </Grid>
                        </StackPanel>

                        <!-- ── ElevenLabs section ───────────── -->
                        <StackPanel Visibility="{Binding Voice.IsElevenLabs, Converter={StaticResource BoolToVisConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Voice.ElevenLabsApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Voice.ElevenLabsModelId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Fetch Voices"
                                        Command="{Binding Voice.FetchElevenLabsVoicesCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Voice.ElevenLabsStatus}"
                                           Foreground="#89B4FA" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.ElevenLabsVoices}"
                                          SelectedValue="{Binding Voice.ElevenLabsSelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Test Voice (both engines) -->
                        <Button Content="Test Voice" Command="{Binding Voice.TestVoiceCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Overlay Appearance" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Width:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Height:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font Size:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.FontSize, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Reset Overlay Position"
                                    Command="{Binding ResetOverlayPositionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Clears the saved overlay position so it opens centred on screen next time."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Phrases Tab -->
            <TabItem Header="Phrases">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Quick Phrases" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Search / filter bar -->
                    <Grid Grid.Row="1" Margin="8,6,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search box -->
                        <Grid Margin="0,0,6,0">
                            <TextBox Text="{Binding Phrases.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <TextBlock Text="Search phrases..."
                                       Foreground="#6C7086" FontSize="12"
                                       IsHitTestVisible="False"
                                       Margin="10,7,0,0"
                                       Visibility="{Binding Phrases.FilterText, Converter={StaticResource EmptyToVisibleConverter}}"/>
                        </Grid>

                        <!-- Category filter -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Phrases.Categories}"
                                  SelectedItem="{Binding Phrases.SelectedCategory}"
                                  Margin="0,0,6,0"
                                  Style="{StaticResource SettingsComboBox}"/>

                        <!-- Favorites toggle -->
                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding Phrases.ShowFavoritesOnly}"
                                      Padding="10,5"
                                      Background="#2B2B3D"
                                      Foreground="#CDD6F4"
                                      BorderBrush="#45475A"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      ToolTip="Show favorites only">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#2B2B3D"/>
                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                    <Setter Property="BorderBrush" Value="#45475A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <!-- ControlTemplate required so WPF system theme cannot override colours -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#45475A"/>
                                                        <Setter Property="Foreground" Value="#F9E2AF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#3B3B55"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsChecked" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bg" Property="Background" Value="#55577A"/>
                                                        <Setter Property="Foreground" Value="#F9E2AF"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="&#x2605; Favorites" FontSize="12"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Phrase list -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Phrases.FilteredPhrases}"
                             SelectedItem="{Binding Phrases.SelectedPhrase}"
                             Background="#2B2B3D"
                             Foreground="#CDD6F4"
                             BorderBrush="#45475A"
                             Margin="8,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#45475A"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3B3B55"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Favorite star -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#x2605;"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#45475A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Foreground" Value="#F9E2AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Pin indicator -->
                                    <TextBlock Grid.Column="1"
                                               Text="&#x1F4CC;"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Name + text -->
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#CDD6F4"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#CBA6F7"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Category, Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" Foreground="#6C7086" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                    <!-- Hotkey -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Hotkey, Converter={StaticResource HotkeyDisplayConverter}}"
                                               Foreground="#89B4FA" FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add/Delete/Play controls -->
                    <StackPanel Grid.Row="3" Margin="8,12,8,0">
                        <!-- Input row: name, text, category -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,4,0">
                                <TextBox x:Name="PhraseNameBox"
                                         Text="{Binding Phrases.EditName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Phrase name..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditName, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="1" Margin="4,0,4,0">
                                <TextBox x:Name="PhraseTextBox"
                                         Text="{Binding Phrases.EditText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Phrase text..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditText, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,0,0">
                                <TextBox Text="{Binding Phrases.EditCategory, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Category..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditCategory, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add" Command="{Binding Phrases.AddCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                            <Button Content="Update" Command="{Binding Phrases.UpdateCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Save changes to the selected phrase"/>
                            <Button Content="Delete" Command="{Binding Phrases.DeleteCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                            <Button Content="▶ Play" Command="{Binding Phrases.PlayCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="★ Fav" Command="{Binding Phrases.ToggleFavoriteCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Toggle favorite on selected phrase"/>
                            <Button Content="📌 Pin" Command="{Binding Phrases.TogglePinnedCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Toggle pin on selected phrase"/>
                            <Button Content="Import..." Command="{Binding Phrases.ImportCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Export..." Command="{Binding Phrases.ExportCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Phrases.PhraseStatusMessage}"
                                   Foreground="#A6E3A1" FontSize="12"
                                   Visibility="{Binding Phrases.PhraseStatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <!-- Hotkey assignment for selected phrase -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding Phrases.SelectedPhrase, Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hotkey:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="PhraseHotkeyBox"
                                     Text="{Binding Phrases.SelectedPhraseHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     PreviewKeyDown="PhraseHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"
                                     Margin="8,0"/>
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Command="{Binding Phrases.ClearHotkeyCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Replacements Tab -->
            <TabItem Header="Replacements">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Text Replacements" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Global enable toggle -->
                    <CheckBox Grid.Row="1"
                              Content="Enable text replacements"
                              IsChecked="{Binding TextReplacements.IsEnabled}"
                              Foreground="#CDD6F4"
                              Margin="8,8,8,8"/>

                    <!-- Rules DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding TextReplacements.Rules}"
                              SelectedItem="{Binding TextReplacements.SelectedRule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              Background="#2B2B3D"
                              Foreground="#CDD6F4"
                              BorderBrush="#45475A"
                              BorderThickness="1"
                              RowBackground="#2B2B3D"
                              AlternatingRowBackground="#313145"
                              HorizontalGridLinesBrush="#45475A"
                              VerticalGridLinesBrush="#45475A"
                              Margin="8,0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="#45475A"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#45475A"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3B3B55"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                            <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerText, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#313145"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="CaretBrush" Value="#CDD6F4"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Replacement" Binding="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#313145"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="CaretBrush" Value="#CDD6F4"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Case" Binding="{Binding IsCaseSensitive, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                            <DataGridCheckBoxColumn Header="Word" Binding="{Binding WholeWordOnly, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Content="Add" Command="{Binding TextReplacements.AddCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding TextReplacements.DeleteCommand}"
                                Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                        <Button Content="▲ Up" Command="{Binding TextReplacements.MoveUpCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="▼ Down" Command="{Binding TextReplacements.MoveDownCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Import..." Command="{Binding TextReplacements.ImportCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Export..." Command="{Binding TextReplacements.ExportCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="{Binding TextReplacements.StatusMessage}"
                               Foreground="#A6E3A1" FontSize="12"
                               Visibility="{Binding TextReplacements.StatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                               Margin="8,2,8,4" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                Background="#2B2B3D"
                BorderBrush="#45475A"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"
                        Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveError}"
                               Foreground="#F38BA8" FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="340"
                               Margin="0,0,12,0"
                               Visibility="{Binding SaveError, Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Phrase regeneration overlay — blocks entire window with progress -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="100"
              Visibility="{Binding IsRegenerating, Converter={StaticResource BoolToVisConverter}}">
            <Grid.Background>
                <SolidColorBrush Color="#1E1E2E" Opacity="0.92"/>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Regenerating Phrases"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#89B4FA"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Voice changed — re-generating cached audio."
                           FontSize="12" Foreground="#A6ADC8"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding RegenerationStatus}"
                           FontSize="14" Foreground="#CDD6F4"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar IsIndeterminate="True"
                             Width="320" Height="4"
                             Foreground="#89B4FA" Background="#45475A"
                             BorderThickness="0"/>
                <TextBlock Text="Please wait — do not close this window."
                           FontSize="11" Foreground="#6C7086"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
