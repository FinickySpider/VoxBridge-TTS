<Window x:Class="TtsCommunicationTool.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TtsCommunicationTool.UI.ViewModels"
        xmlns:conv="clr-namespace:TtsCommunicationTool.UI.Converters"
    xmlns:core="clr-namespace:TtsCommunicationTool.Core;assembly=TtsCommunicationTool.Core"
    Title="{x:Static core:AppMetadata.SettingsTitle}"
        Width="880" Height="580"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource UiFontFamilyResource}"
        FontSize="{DynamicResource BaseFontSizeResource}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibleConverter"/>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibleConverter"/>
        <conv:HotkeyBindingDisplayConverter x:Key="HotkeyDisplayConverter"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrushConverter"/>
        <conv:ContrastStatusToBrushConverter x:Key="ContrastStatusToBrushConverter"/>
        <conv:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius"/>

        <!-- Shared styles for dark-themed controls -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="SettingsPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource MutedTextBrush}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSizeResource}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="{DynamicResource ControlPaddingResource}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadiusResource}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSizeResource}"/>
            <Setter Property="Padding" Value="{DynamicResource ControlPaddingResource}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadiusResource}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeRowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSizeResource}"/>
            <Setter Property="Padding" Value="{DynamicResource ControlPaddingResource}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadiusResource}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ErrorHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable colour swatch � used in Theme editor colour rows -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Click to open colour picker dialog"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="12,12,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding General.StartWithWindows}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show toast notifications"
                                  IsChecked="{Binding General.ShowNotifications}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show splash screen on startup"
                                  IsChecked="{Binding General.ShowSplashScreen}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>
                        <TextBlock Text="Transcript" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Log spoken messages to transcript file"
                                  IsChecked="{Binding General.EnableTranscriptLogging}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <TextBlock Text="Saves every sent message with a timestamp to a plain text file in your AppData folder."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Button Content="Open Transcript File"
                                Command="{Binding General.OpenTranscriptCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4"/>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>
                        <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Keep unsent text when overlay closes"
                                  IsChecked="{Binding General.KeepOverlayText}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <TextBlock Text="When enabled, any text typed but not sent will be restored the next time you open the overlay."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Show remaining playback time in overlay"
                                  IsChecked="{Binding General.ShowPlaybackTimer}"
                                  ToolTip="Displays a live countdown next to 'Speaking...' in the overlay status bar."
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <TextBlock Text="Shows a countdown timer in the overlay status bar while audio is playing, e.g. 'Speaking...  (45s)'."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>
                        <TextBlock Text="Message Length" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Limit message length"
                                  IsChecked="{Binding General.EnableCharacterLimit}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <Grid Margin="0,4,0,0"
                              IsEnabled="{Binding General.EnableCharacterLimit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum characters:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding General.MaxOverlayInputLength, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>
                        <TextBlock Text="Controls the character limit displayed on the overlay input field. When off, only character count is shown."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>

                        <!-- ═══════════════════════════════════════════════════ -->
                        <!-- Diagnostics / Debug Logging                       -->
                        <!-- ═══════════════════════════════════════════════════ -->
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>

                        <Border Background="#1C0F0F"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>

                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚠" Foreground="{DynamicResource ErrorBrush}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Diagnostics / Debug Logging"
                                               Foreground="{DynamicResource ErrorBrush}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Warning text -->
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource ErrorBrush}" Opacity="0.80"
                                           Margin="0,0,0,10">
                                    These options are for bug hunting and developer diagnostics only.
                                    Leave them all off unless you know exactly what they do.
                                    Some settings may produce large log files or store sensitive content on disk.
                                </TextBlock>

                                <!-- Enable diagnostic logging -->
                                <CheckBox Content="Enable diagnostic logging"
                                          IsChecked="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,4"/>

                                <!-- Verbose logging -->
                                <CheckBox Content="Verbose logging (includes DEBUG events)"
                                          IsChecked="{Binding General.VerboseLogging}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,2"/>

                                <!-- Trace logging -->
                                <CheckBox Content="Trace logging (TRACE and above � very chatty)"
                                          IsChecked="{Binding General.TraceLogging}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,2"/>

                                <!-- Request IDs -->
                                <CheckBox Content="Include request correlation IDs"
                                          IsChecked="{Binding General.IncludeRequestIds}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,2"/>

                                <!-- Raw text � extra warning -->
                                <CheckBox Content="⚠  Log raw spoken text  (UNSAFE)"
                                          IsChecked="{Binding General.LogRawText}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"
                                          FontSize="13" Margin="0,6,0,2"/>

                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource ErrorBrush}" Opacity="0.70"
                                           Margin="22,0,0,8">
                                    PRIVACY WARNING: When enabled, the full text of everything you
                                    speak may be written to log files on disk. Only enable this if
                                    you fully understand the privacy implications.
                                </TextBlock>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Open Logs Folder"
                                            Command="{Binding General.OpenLogsFolderCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Delete Old Logs"
                                            Command="{Binding General.DeleteOldLogsCommand}"
                                            Padding="16,8" Cursor="Hand" FontSize="13"
                                            BorderThickness="1" BorderBrush="{DynamicResource ErrorBrush}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="#2E1010"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="Delete Old Logs"
                                                               Foreground="{DynamicResource ErrorBrush}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#4A1A1A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Click a field, then press the desired key combination. Esc clears a binding. Modifier keys are optional; function keys such as F13 can be used by themselves."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Toggle Overlay:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Global hotkey to open or close the overlay input window from anywhere on your desktop."/>
                            <TextBox Grid.Column="1"
                                     x:Name="OverlayHotkeyBox"
                                     Text="{Binding Hotkeys.OverlayHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Global hotkey to open or close the overlay input window. Click here, then press a key combination."
                                     PreviewKeyDown="OverlayHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop Playback:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Global hotkey to immediately stop any audio currently playing � TTS, phrase, or resend."/>
                            <TextBox Grid.Column="1"
                                     x:Name="StopHotkeyBox"
                                     Text="{Binding Hotkeys.StopHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Global hotkey to immediately stop any audio currently playing. Click here, then press a key combination."
                                     PreviewKeyDown="StopHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Open Settings:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Optional global hotkey to open the Settings window. Leave as (none) to disable. Press Esc to clear."/>
                            <TextBox Grid.Column="1"
                                     x:Name="SettingsHotkeyBox"
                                     Text="{Binding Hotkeys.SettingsHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Optional global hotkey to open the Settings window. Press Esc to clear and leave unbound."
                                     PreviewKeyDown="SettingsHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resend Last:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Optional global hotkey to re-speak the last message without opening the overlay. Leave as (none) to disable."/>
                            <TextBox Grid.Column="1"
                                     x:Name="ResendHotkeyBox"
                                     Text="{Binding Hotkeys.ResendHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Optional global hotkey to re-speak your last spoken message. Press Esc to clear and leave unbound."
                                     PreviewKeyDown="ResendHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <!-- Separator -->
                        <Separator Margin="0,4,0,12" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Overlay Shortcuts" Style="{StaticResource SectionHeader}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                                   Text="These shortcuts are only active while the overlay input window is open. They do not require global hotkey registration."/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop + Send:" Style="{StaticResource FieldLabel}"
                                       ToolTip="While the overlay is open: immediately stops any audio that is currently playing, then sends the text you have typed. Default is Ctrl+Enter."/>
                            <TextBox Grid.Column="1"
                                     x:Name="OverrideHotkeyBox"
                                     Text="{Binding Hotkeys.OverrideHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Overlay-only shortcut: stops current audio and immediately sends your overlay text. Default: Ctrl+Enter. Press Esc to clear."
                                     PreviewKeyDown="OverrideHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <TextBlock Text="{Binding Hotkeys.ValidationMessage}"
                                   Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Audio Devices" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor (You):" Style="{StaticResource FieldLabel}"
                                       ToolTip="The audio device you hear yourself on. Usually your headphones or speakers."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedMonitorDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The audio device you hear yourself on (headphones, speakers, etc.). All TTS, phrases, and UI sounds play here."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary (App):" Style="{StaticResource FieldLabel}"
                                       ToolTip="The virtual audio device routed into Discord, VRChat, or other voice apps. Usually VB-Cable or a similar virtual cable."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedSecondaryDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The secondary output device routed to Discord/VRChat (e.g. VB-Cable). Only TTS speech and phrase audio are sent here. UI sounds play on the monitor device only."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Test Monitor" Command="{Binding Audio.TestMonitorCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Secondary" Command="{Binding Audio.TestSecondaryCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Both" Command="{Binding Audio.TestBothCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="↻ Refresh" Command="{Binding Audio.RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Audio.DeviceWarning}"
                                   Foreground="{DynamicResource InfoBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="Volume" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>

                        <!-- Monitor Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                       ToolTip="Volume you hear in your own headphones/speakers."/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.MonitorVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip="Volume of TTS and phrase audio in your own monitor device."/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.MonitorVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Secondary Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                       ToolTip="Volume sent to the secondary voice device (Discord/VRChat)."/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.SecondaryVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip="Volume of TTS and phrase audio sent to the secondary voice device. UI sounds are never routed here."/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.SecondaryVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Audio routing note -->
                        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ Audio Routing" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                           Text="Only TTS speech and phrase audio are sent to the secondary (app) device. Any non-voice sounds such as UI feedback or error tones play on the monitor device only and will not be heard in Discord or VRChat."/>
                            </StackPanel>
                        </Border>

                        <!-- Trailing Silence -->
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,16,0,12"/>
                        <TextBlock Text="Trailing Silence" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                        <Border Background="#1C1200" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoBrush}" FontSize="12"
                                       Text="?  Trimming too aggressively may clip the last word of a sentence. Start with a high retention value (80�95%) and reduce gradually."/>
                        </Border>

                        <CheckBox Content="Trim trailing silence from generated audio"
                                  IsChecked="{Binding Audio.TrimTrailingSilence}"
                                  ToolTip="Removes silence at the end of each generated audio clip so playback ends sooner."
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <Grid Margin="0,8,0,4"
                              IsEnabled="{Binding Audio.TrimTrailingSilence}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="5" Maximum="100" TickFrequency="5"
                                    Value="{Binding Audio.SilenceRetentionPercent}"
                                    VerticalAlignment="Center"
                                    ToolTip="How much trailing silence to keep after trimming. 100% keeps all silence; 5% keeps almost none."/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Audio.SilenceRetentionDisplay}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Silence retention  (5% = most trimmed, 100% = off)"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="Only applies to real-time TTS output. Cached phrase audio is not trimmed."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Voice Tab -->
            <TabItem Header="Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Voice Engine" Style="{StaticResource SectionHeader}"/>

                        <!-- Engine selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="Kokoro (Offline)"
                                         Foreground="{DynamicResource PrimaryTextBrush}" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsKokoro, Mode=TwoWay}"
                                         Margin="0,0,16,0"
                                         ToolTip="Kokoro is a local, fully offline TTS engine. No internet or API key required. Voice models are bundled with the app."/>
                            <RadioButton Content="ElevenLabs (Online)"
                                         Foreground="{DynamicResource PrimaryTextBrush}" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsElevenLabs, Mode=TwoWay}"
                                         ToolTip="ElevenLabs is a cloud TTS engine. Requires an internet connection and a valid ElevenLabs API key."/>
                        </StackPanel>

                        <!-- Kokoro section -->
                        <StackPanel Visibility="{Binding Voice.IsKokoro, Converter={StaticResource BoolToVisConverter}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The Kokoro voice model to use for speech generation."/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.KokoroVoices}"
                                          SelectedValue="{Binding Voice.SelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="Select the Kokoro voice model to use for speech generation."/>
                            </Grid>
                        </StackPanel>

                        <!-- ElevenLabs section -->
                        <StackPanel Visibility="{Binding Voice.IsElevenLabs, Converter={StaticResource BoolToVisConverter}}">

                            <!-- API Key label row -->
                            <TextBlock Text="API Key" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                            <!-- �� SAVED state � show masked tail + action buttons �� -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding Voice.IsApiKeySaved, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding Voice.ApiKeyMaskedDisplay}"
                                           Foreground="{DynamicResource SuccessBrush}" FontSize="13" FontFamily="Consolas"
                                           Margin="0,0,0,6"
                                           ToolTip="Masked tail of your stored API key. The full key is encrypted and never shown."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test API"
                                            Command="{Binding Voice.TestApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Test the currently stored API key against ElevenLabs."/>
                                    <Button Content="Update Key"
                                            Command="{Binding Voice.StartEditApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Enter a new API key to replace the stored one."/>
                                    <Button Content="Clear API"
                                            Command="{Binding Voice.ClearApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Remove the stored API key permanently."/>
                                </StackPanel>
                            </StackPanel>

                            <!-- �� INPUT state � PasswordBox for entry (Empty or Editing) �� -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding Voice.IsApiKeyInputShown, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4"
                                           Text="No API key stored � paste your key below."
                                           Visibility="{Binding Voice.IsApiKeyEmpty, Converter={StaticResource BoolToVisConverter}}"/>
                                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,0,0,4"
                                           Text="⚠ Unsaved � click Save to encrypt and store."
                                           Visibility="{Binding Voice.IsApiKeyEditing, Converter={StaticResource BoolToVisConverter}}"/>
                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                             Style="{StaticResource SettingsPasswordBox}"
                                             MaxLength="512"
                                             Margin="0,0,0,6"
                                             ToolTip="Paste your ElevenLabs API key. It will be encrypted with Windows DPAPI before saving � never shown in plain text again."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save"
                                            Command="{Binding Voice.SaveApiKeyCommand}"
                                            IsEnabled="{Binding Voice.CanSaveApiKey}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Encrypt and save the key. It will be stored with Windows DPAPI and usable only by your Windows account."/>
                                    <Button Command="{Binding Voice.TestApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Test this key against ElevenLabs without saving it first.">
                                        <Button.Content>Test (unsaved)</Button.Content>
                                    </Button>
                                    <Button Content="Cancel"
                                            Command="{Binding Voice.CancelApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Visibility="{Binding Voice.IsApiKeyEditing, Converter={StaticResource BoolToVisConverter}}"
                                            ToolTip="Discard this entry and revert to the previously saved key."/>
                                </StackPanel>
                            </StackPanel>

                            <!-- �� CLEARING state � confirmation prompt �� -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding Voice.IsApiKeyClearing, Converter={StaticResource BoolToVisConverter}}">
                                <Border Background="#302030" CornerRadius="4" BorderBrush="{DynamicResource ErrorBrush}"
                                        BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                    <TextBlock Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"
                                               Text="⚠ This will permanently remove the stored API key. ElevenLabs voices will be unavailable until a new key is entered. Confirm?"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Confirm Clear"
                                            Command="{Binding Voice.ConfirmClearApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Permanently delete the stored API key."/>
                                    <Button Content="Cancel"
                                            Command="{Binding Voice.CancelApiKeyCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Keep the existing API key."/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Status line (shared across all key states) -->
                            <TextBlock Text="{Binding Voice.ElevenLabsStatus}"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,8"
                                       Visibility="{Binding Voice.ElevenLabsStatus, Converter={StaticResource NonEmptyToVisibleConverter}}"/>

                            <!-- Model dropdown -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The ElevenLabs model to use. Flash/Turbo are faster and cheaper; Multilingual v2 and v3 offer higher quality."/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.ElevenLabsModelOptions, Mode=OneTime}"
                                          SelectedValue="{Binding Voice.ElevenLabsModelId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="Select the ElevenLabs model. Flash v2.5 and Turbo v2.5 cost $0.05/1K chars. v3 Multilingual and Multilingual v2 cost $0.10/1K chars."/>
                            </Grid>

                            <!-- Subscription / lifetime credit display -->
                            <TextBlock Text="{Binding Voice.ElevenLabsCreditsDisplay}"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12"
                                       Margin="140,0,0,2"
                                       Visibility="{Binding Voice.ElevenLabsCreditsDisplay,
                                           Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                            <TextBlock Text="{Binding Voice.ElevenLabsLifetimeCharacters}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       Margin="140,0,0,10"
                                       Visibility="{Binding Voice.ElevenLabsLifetimeCharacters,
                                           Converter={StaticResource NonEmptyToVisibleConverter}}"/>

                            <!-- Fetch Voices button -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Fetch Voices"
                                        Command="{Binding Voice.FetchElevenLabsVoicesCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        ToolTip="Download the list of voices available to your ElevenLabs account. Voices are also fetched automatically when you save a new API key or select the ElevenLabs engine."/>
                            </StackPanel>

                            <!-- Voice selector with custom voice highlighting -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The ElevenLabs voice to use. Voices shown in red require Creator or higher subscription."/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.ElevenLabsVoices}"
                                          SelectedValue="{Binding Voice.ElevenLabsSelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="Select the ElevenLabs voice. Red entries are cloned or AI-generated voices requiring a Creator plan or higher.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomVoice}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Custom voice info panel -->
                            <Border Margin="0,4,0,12" Padding="12,10"
                                    Background="{DynamicResource DeepPanelBackgroundBrush}" CornerRadius="4"
                                    BorderBrush="{DynamicResource Surface0Brush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,0,0,4"
                                               Text="About highlighted voices"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12">
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">Voices shown in </Run>
                                        <Run Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold">red</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}"> are cloned or AI-generated voices stored on your ElevenLabs account. They require a </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold">Creator plan or higher</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}"> to use. Standard voices (shown in white) are available on all plans including Free and Starter.</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Global Pitch (both engines) -->
                        <TextBlock Text="Global Pitch" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                                   Text="Adjusts the pitch of all standard TTS output. Changes apply immediately so you can hear the effect before saving. Cached phrases are unaffected."/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pitch:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Pitch multiplier applied to real-time TTS output. 1.0 = normal pitch. 0.5 = lower/slower. 2.0 = higher/faster. Use Test Voice to preview."/>
                            <Slider Grid.Column="1"
                                    Minimum="0.5" Maximum="2.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Voice.GlobalPitch, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTip="Drag to adjust pitch. 1.0 = normal. Changes are previewed immediately; press Cancel to revert."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Voice.GlobalPitchPercent}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip="Current pitch value as a percentage of normal."/>
                        </Grid>

                        <!-- Global Speed -->
                        <TextBlock Text="Global Speed" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                                   Text="Adjusts the playback speed of standard TTS output from the floating overlay. Phrase playback is unaffected. Changes apply immediately; Cancel restores the saved value."/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Playback speed multiplier for standard TTS output. 1.0 = normal."/>
                            <Slider Grid.Column="1"
                                    Minimum="0.5" Maximum="2.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Voice.GlobalSpeed, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTip="Drag to adjust playback speed. Changes are previewed immediately; press Cancel to revert."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Voice.GlobalSpeedPercent}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip="Current playback speed as a percentage of normal."/>
                        </Grid>

                        <!-- Test Voice (both engines) -->
                        <Button Content="Test Voice" Command="{Binding Voice.TestVoiceCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                ToolTip="Speak a sample phrase using the current engine, voice, and pitch settings."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Overlay Appearance" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Width:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Width of the overlay input window in pixels."/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"
                                     ToolTip="Width of the overlay input window in pixels."/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Height:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Height of the overlay input window in pixels."/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"
                                     ToolTip="Height of the overlay input window in pixels."/>
                        </Grid>

                        <!-- Overlay transparency slider (0.20 = see-through, 0.95 = opaque) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transparency:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Background opacity of the overlay window."/>
                            <Slider Grid.Column="1"
                                    Minimum="0.20" Maximum="0.95"
                                    Value="{Binding Appearance.OverlayOpacity, UpdateSourceTrigger=PropertyChanged}"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ToolTip="Background opacity of the overlay."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Appearance.OverlayOpacity, StringFormat={}{0:P0}}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="4,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Reset Overlay Position"
                                    Command="{Binding ResetOverlayPositionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Clears the saved overlay position so it opens centred on screen next time."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Replacements Tab -->
            <TabItem Header="Replacements">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Text Replacements" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Global enable toggle -->
                    <CheckBox Grid.Row="1"
                              Content="Enable text replacements"
                              IsChecked="{Binding TextReplacements.IsEnabled}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="8,8,8,8"/>

                    <!-- Rules DataGrid -->
                    <DataGrid x:Name="ReplacementsGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding TextReplacements.Rules}"
                              SelectedItem="{Binding TextReplacements.SelectedRule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              RowBackground="{DynamicResource PanelBackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource Surface0Brush}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              AllowDrop="True"
                              Margin="8,0"
                              PreviewMouseLeftButtonDown="ReplacementsGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ReplacementsGrid_PreviewMouseMove"
                              DragOver="ReplacementsGrid_DragOver"
                              DragLeave="ReplacementsGrid_DragLeave"
                              Drop="ReplacementsGrid_Drop"
                              CurrentCellChanged="ReplacementsGrid_CurrentCellChanged"
                              PreparingCellForEdit="ReplacementsGrid_PreparingCellForEdit">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3A4060"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="#2E3D6A"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3B3B55"/>
                                    </Trigger>
                                    <!-- New/empty rows get a tinted indicator so users know they can click in -->
                                    <DataTrigger Binding="{Binding TriggerText}" Value="">
                                        <Setter Property="Background" Value="#1A2540"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>

                            <!-- Trigger column � filled rows blend in as plain text; empty (new) rows show input border -->
                            <DataGridTemplateColumn Header="Trigger  ?" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CellBorder"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="3" Margin="2,1" Padding="5,3"
                                                Cursor="IBeam" ToolTip="Click to edit">
                                            <TextBlock Text="{Binding TriggerText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Empty/new rows get input-box styling so the clickable area is obvious -->
                                            <DataTrigger Binding="{Binding TriggerText}" Value="">
                                                <Setter TargetName="CellBorder" Property="Background" Value="#252540"/>
                                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TriggerText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource Surface0Brush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                 CaretBrush="{DynamicResource PrimaryTextBrush}" Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Replacement column � same treatment -->
                            <DataGridTemplateColumn Header="Replacement  ?" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CellBorder"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="3" Margin="2,1" Padding="5,3"
                                                Cursor="IBeam" ToolTip="Click to edit">
                                            <TextBlock Text="{Binding ReplacementText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Empty/new rows get input-box styling so the clickable area is obvious -->
                                            <DataTrigger Binding="{Binding ReplacementText}" Value="">
                                                <Setter TargetName="CellBorder" Property="Background" Value="#252540"/>
                                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource Surface0Brush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                 CaretBrush="{DynamicResource PrimaryTextBrush}" Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="Case" Binding="{Binding IsCaseSensitive, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                            <DataGridCheckBoxColumn Header="Word" Binding="{Binding WholeWordOnly, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action buttons - primary actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,8,8,2">
                        <Button Content="Add" Command="{Binding TextReplacements.AddCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding TextReplacements.DeleteCommand}"
                                Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                        <Button Content="▲ Up" Command="{Binding TextReplacements.MoveUpCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="▼ Down" Command="{Binding TextReplacements.MoveDownCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="{Binding TextReplacements.StatusMessage}"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                               Visibility="{Binding TextReplacements.StatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                               Margin="8,2,8,2" TextWrapping="Wrap"/>

                    <!-- How it works � 2-column reference panel -->
                    <Border Grid.Row="5"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="8,4,8,8"
                            Padding="0"
                            MaxHeight="340">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: How it works + ELI5 example -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,5">How text replacements work</TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,6">
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">Text replacements are rules that say: </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold">&#x201C;When I type this, replace it with that.&#x201D;</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,4">
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">The app checks rules </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold">top to bottom</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">. The </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold">first matching rule wins</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}"> &#x2014; rules below it are skipped for that match.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,12">
                                        <Run Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold">Tip: </Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">Put more specific triggers above shorter or broader ones.</Run>
                                    </TextBlock>

                                    <Border Height="1" Background="#3A3A5C" Margin="0,0,0,10"/>

                                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,6">ELI5 example</TextBlock>

                                    <!-- Settings context for this example -->
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3">Settings used in this example</TextBlock>
                                    <Border Background="{DynamicResource DeepPanelBackgroundBrush}" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">&#x2022; <Run FontFamily="Consolas" Foreground="{DynamicResource PrimaryTextBrush}">omw</Run> has <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold">Word</Run> turned ON.</TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">&#x2022; <Run FontFamily="Consolas" Foreground="{DynamicResource PrimaryTextBrush}">w</Run> does <Run Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold">not</Run> have <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold">Word</Run> turned on.</TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0">&#x2022; Neither rule has <Run Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold">Case</Run> turned on.</TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Good order -->
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3">Rules in this order:</TextBlock>
                                    <Border Background="#1A2E1A" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">1. omw &#x2192; on my way</TextBlock>
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">2. w &#x2192; with</TextBlock>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}">Typing </Run>
                                                <Run Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas">omw w snacks</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> &#x2192; </Run>
                                                <Run Foreground="{DynamicResource SuccessBrush}" FontFamily="Consolas">on my way with snacks</Run>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                                <Run Foreground="{DynamicResource SuccessBrush}">&#x2714; Good order.</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> Specific rule wins first.</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bad order -->
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3">But if flipped:</TextBlock>
                                    <Border Background="#2E1A1A" CornerRadius="3" Padding="8,5" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">1. w &#x2192; with</TextBlock>
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">2. omw &#x2192; on my way</TextBlock>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}">Typing </Run>
                                                <Run Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas">omw w snacks</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> could become </Run>
                                                <Run Foreground="{DynamicResource ErrorBrush}" FontFamily="Consolas">omwith with snacks</Run>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                                <Run Foreground="{DynamicResource ErrorBrush}">&#x2718; Oops.</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> The </Run>
                                                <Run FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}">w</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> inside </Run>
                                                <Run FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}">omw</Run>
                                                <Run Foreground="{DynamicResource SecondaryTextBrush}"> was matched first.</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="#3A3A5C" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Foreground="{DynamicResource SuccessBrush}">&#x25B8; </Run><Run Foreground="{DynamicResource SecondaryTextBrush}">Put longer, more specific triggers near the top.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Foreground="{DynamicResource SuccessBrush}">&#x25B8; </Run><Run Foreground="{DynamicResource SecondaryTextBrush}">Put shorter, more general triggers lower down.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Foreground="{DynamicResource SuccessBrush}">&#x25B8; </Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">Use </Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold">Word</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}"> for short triggers when you only want whole-word matches.</Run>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Background="#3A3A5C" Margin="0,4,0,4"/>

                                <!-- RIGHT: Settings key -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,5">Settings key</TextBlock>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Enable text replacements</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">Turns the whole feature on or off. If off, no replacements happen regardless of individual row settings.</TextBlock>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">On (per row)</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">Enables or disables one specific rule. Other rules are unaffected.</TextBlock>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Trigger</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">The text the app looks for. Example:</TextBlock>
                                    <Border Background="{DynamicResource DeepPanelBackgroundBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">brb</TextBlock>
                                    </Border>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Replacement</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">The text that replaces the trigger. Example:</TextBlock>
                                    <Border Background="{DynamicResource DeepPanelBackgroundBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,0,2" HorizontalAlignment="Left">
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontFamily="Consolas">be right back</TextBlock>
                                    </Border>
                                    <TextBlock FontSize="11" Margin="0,0,0,8">
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">So: </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas">brb</Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}"> &#x2192; </Run>
                                        <Run Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas">be right back</Run>
                                    </TextBlock>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Case</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">
                                        <Run FontWeight="SemiBold">On:</Run> trigger must match capitalization exactly. <Run FontFamily="Consolas">brb</Run> &#x2260; <Run FontFamily="Consolas">BRB</Run> &#x2260; <Run FontFamily="Consolas">Brb</Run>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">
                                        <Run FontWeight="SemiBold">Off:</Run> capitalization doesn&#x2019;t have to match. All variants trigger the same rule.
                                    </TextBlock>

                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Word</TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">
                                        <Run FontWeight="SemiBold">On:</Run> trigger only fires when it&#x2019;s a whole word. <Run FontFamily="Consolas">cat</Run> matches <Run FontFamily="Consolas">cat</Run> but not <Run FontFamily="Consolas">catalog</Run>.
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">Off:</Run> trigger can match inside a longer word.
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="16">
                                        <Run Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold">Careful: </Run>
                                        <Run Foreground="{DynamicResource SecondaryTextBrush}">Short triggers with Word OFF can cause surprising matches inside longer words.</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>            <!-- Phrases Tab -->
            <TabItem Header="Phrases">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0: title -->
                        <RowDefinition Height="Auto"/>  <!-- 1: search bar -->
                        <RowDefinition Height="*"/>     <!-- 2: list (ListView+GridView has native headers) -->
                        <RowDefinition Height="Auto"/>  <!-- 3: controls -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="Quick Phrases" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Search / filter bar -->
                    <Grid Grid.Row="1" Margin="8,6,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search box -->
                        <Grid Margin="0,0,6,0">
                            <TextBox Text="{Binding Phrases.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <TextBlock Text="Search phrases..."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                       IsHitTestVisible="False"
                                       Margin="10,7,0,0"
                                       Visibility="{Binding Phrases.FilterText, Converter={StaticResource EmptyToVisibleConverter}}"/>
                        </Grid>

                        <!-- Category filter -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Phrases.Categories}"
                                  SelectedItem="{Binding Phrases.SelectedCategory}"
                                  Margin="0,0,6,0"
                                  Style="{StaticResource SettingsComboBox}"/>

                        <!-- Favorites toggle -->
                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding Phrases.ShowFavoritesOnly}"
                                      Padding="10,5"
                                      Background="{DynamicResource PanelBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      ToolTip="Show favorites only">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <!-- ControlTemplate required so WPF system theme cannot override colours -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#3B3B55"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsChecked" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bg" Property="Background" Value="#A6C8FF"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#A6C8FF"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="&#x2605; Favorites" FontSize="12"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Phrase list -->
                    <ListView x:Name="PhraseListView"
                              Grid.Row="2"
                              GridViewColumnHeader.Click="PhraseSort_Click"
                              SizeChanged="PhraseListView_SizeChanged"
                              Loaded="PhraseListView_Loaded"
                              PreviewMouseDown="PhraseListView_PreviewMouseDown"
                              MouseDoubleClick="PhraseListView_MouseDoubleClick"
                              KeyDown="PhraseListView_KeyDown"
                              ItemsSource="{Binding Phrases.FilteredPhrases}"
                              SelectedItem="{Binding Phrases.SelectedPhrase}"
                              Background="{DynamicResource PanelBackgroundBrush}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="8,4,8,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Flat ControlTemplate: replaces WPF's Aero/theme selection chrome (the thick top bar) -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0"
                                                    SnapsToDevicePixels="True">
                                                <GridViewRowPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3B3B55"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#4A4E6A"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Tag tunnels window DataContext into the ContextMenu (lives outside visual tree) -->
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <ContextMenu.Resources>
                                                <!-- ControlTemplate on ContextMenu itself � WPF default popup chrome renders white otherwise -->
                                                <Style TargetType="ContextMenu">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContextMenu">
                                                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="0,3">
                                                                    <StackPanel IsItemsHost="True"
                                                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <!-- Full ControlTemplate required � WPF defaults ignore Background without it -->
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Padding" Value="22,7,18,7"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="MenuItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter ContentSource="Header"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                                                      RecognizesAccessKey="True"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style TargetType="Separator">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Separator">
                                                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,3"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ContextMenu.Resources>
                                            <!-- PlacementTarget = the ListBoxItem; Tag on it = window DataContext; DataContext on it = PhraseItem -->
                                            <MenuItem Header="Edit"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.OpenEditorForSelectedCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator Background="{DynamicResource BorderBrush}"/>
                                            <MenuItem Header="Toggle Favorite"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.ToggleFavoriteByItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Toggle Pin"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.TogglePinnedByItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator Background="{DynamicResource BorderBrush}"/>
                                            <MenuItem Header="Delete"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.DeleteCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <!-- Dark-themed column header style shared by all 5 columns -->
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="#E0E8FF"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="4,6"/>
                                        <Setter Property="MinHeight" Value="34"/>
                                        <!-- Prevent resizable columns from being shrunk to zero/negative -->
                                        <Setter Property="MinWidth" Value="40"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Grid>
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                                                    </Border>
                                                    <!-- PART_HeaderGripper: transparent drag handle on right edge enables column resize -->
                                                    <Thumb x:Name="PART_HeaderGripper"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,-9,0"
                                                           Width="18"
                                                           Cursor="SizeWE">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3B3B55"/>
                                                        </Trigger>
                                                        <Trigger Property="Role" Value="Padding">
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <!-- col 0: ?? Pin � not sortable (pinned items always float to top via primary sort) -->
                                <GridViewColumn Header="&#x1F4CC;" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#x1F4CC;"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                                      Path=DataContext.Phrases.TogglePinnedByItemCommand}"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Toggle pin"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="1"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 1: ? Favorite � width-locked, no resize gripper -->
                                <GridViewColumn Header="&#x2605;" Width="28">
                                    <!-- Override shared style: remove gripper and lock width so this column cannot be resized -->
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="MinWidth" Value="28"/>
                                            <Setter Property="MaxWidth" Value="28"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GridViewColumnHeader">
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                MinHeight="34"
                                                                Padding="4,6">
                                                            <ContentPresenter HorizontalAlignment="Left"
                                                                              VerticalAlignment="Center"
                                                                              TextElement.Foreground="#E0E8FF"
                                                                              TextElement.FontSize="13"
                                                                              TextElement.FontWeight="SemiBold"/>
                                                        </Border>
                                                        <!-- No PART_HeaderGripper: Star column is fixed-width -->
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#3B3B55"/>
                                                            </Trigger>
                                                            <Trigger Property="Role" Value="Padding">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#x2605;"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                                      Path=DataContext.Phrases.ToggleFavoriteByItemCommand}"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Toggle favorite"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="1"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#8899AA"/>
                                                            </Trigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFavorite}" Value="True"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#FFD966"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 2: Name &amp; Text � sortable, auto-fill width -->
                                <GridViewColumn Header="Name &amp; Text  &#x21C5;" Width="185">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2,4,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 3: Engine � sortable -->
                                <GridViewColumn Header="Engine  &#x21C5;" Width="75">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EngineDisplay}"
                                                       Foreground="#89DCEB" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 4: Voice name -->
                                <GridViewColumn Header="Voice" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VoiceDisplay}"
                                                       Foreground="#F2CDCD" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 5: Category � sortable -->
                                <GridViewColumn Header="Category  &#x21C5;" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#CBA6F7" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 6: Hotkey � not sortable -->
                                <GridViewColumn Header="Hotkey" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Hotkey, Converter={StaticResource HotkeyDisplayConverter}}"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Phrase controls: buttons + status + hotkey (all in a StackPanel to auto-stack vertically) -->
                    <StackPanel Grid.Row="3" Margin="8,10,8,6">
                        <!-- Action buttons row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="&#x2736; New Phrase" Command="{Binding Phrases.OpenEditorForNewCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                    ToolTip="Create a new phrase"/>
                            <Button Content="&#x270F; Edit" Command="{Binding Phrases.OpenEditorForSelectedCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Edit the selected phrase (double-click or Enter also works)"/>
                            <Button Content="&#x25B6; Play" Command="{Binding Phrases.PlayCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Play the selected phrase"/>
                            <Button Content="Delete" Command="{Binding Phrases.DeleteCommand}"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Delete the selected phrase"/>
                        </StackPanel>

                        <!-- Status message -->
                        <TextBlock Text="{Binding Phrases.PhraseStatusMessage}"
                                   Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                   Visibility="{Binding Phrases.PhraseStatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <!-- Hotkey assignment for selected phrase -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding Phrases.SelectedPhrase, Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hotkey:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="PhraseHotkeyBox"
                                     Text="{Binding Phrases.SelectedPhraseHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     PreviewKeyDown="PhraseHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"
                                     Margin="8,0"/>
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Command="{Binding Phrases.ClearHotkeyCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Theme Tab (last) -->
            <TabItem Header="Theme">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header + subtitle -->
                    <StackPanel Grid.Row="0" Margin="8,0,8,10">
                        <TextBlock Text="Theme" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Customize the application colours and overlay styling."
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Preset bar -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,8">
                        <DockPanel>
                            <TextBlock Text="Theme Preset" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                            <ComboBox Width="200" DockPanel.Dock="Left"
                                      ItemsSource="{Binding Theme.AvailableThemes}"
                                      SelectedItem="{Binding Theme.SelectedPreset, Mode=TwoWay}"
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Foreground" Value="#CBA6F7"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <!-- Save overwrites for user themes; forks to new for built-ins (banner explains) -->
                                <Button Content="Save"
                                        Command="{Binding Theme.SaveCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Save changes to this theme (built-in themes will be saved as a new user theme)"/>
                                <Button Content="Save As�"
                                        Command="{Binding Theme.SaveAsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Prompt for a new name and save as a new theme"/>
                                <Button Content="Duplicate"
                                        Command="{Binding Theme.DuplicateCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Save a copy with ' Copy' appended to the name"/>
                                <Button Content="Reset"
                                        Command="{Binding Theme.ResetEditsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0"
                                        ToolTip="Revert unsaved edits back to the last saved state"/>
                                <Button Content="Delete"
                                        Command="{Binding Theme.DeleteCommand}"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="Delete this user theme (built-in themes cannot be deleted)"/>
                            </StackPanel>
                            <!-- Theme name textbox fills remaining space -->
                            <TextBox Text="{Binding Theme.ThemeName, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,8,0"
                                     ToolTip="Rename before saving to create a fork of the selected theme"/>
                        </DockPanel>
                    </Border>

                    <!-- Built-in notice banner -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Surface0Brush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6"
                            Visibility="{Binding Theme.IsEditingBuiltIn, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="12">
                            <Run Text="ℹ  This is a built-in theme. Saving will create a new user theme with a unique name (e.g. &#x22;Default Dark Copy&#x22;)."/>
                        </TextBlock>
                    </Border>

                    <!-- Colour editor + Live preview -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="180"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition x:Name="ThemePreviewColumn" Width="300" MinWidth="120" MaxWidth="700"/>
                        </Grid.ColumnDefinitions>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                                      Cursor="SizeWE" Margin="0,2"/>

                        <!-- LEFT: Colour editor � grouped cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,12,10,16">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- A. Background -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="BACKGROUND" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- Window Background -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Main Window Background" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Outermost background of all application windows and dialogs"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.WindowBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #1E1E2E"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="WindowBackground"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="WindowBackground"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="WindowBackground"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Panel Background -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Panel Background" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Background of toolbars, sidebars, tab headers, and floating panels"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.PanelBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #2B2B3D"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.PanelBackground, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="PanelBackground"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="PanelBackground"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="PanelBackground"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Deep Panel / Input Background -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Deep Panel / Input Background" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Background for input fields, text boxes, dropdowns, and recessed surfaces inside panels"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.DeepPanelBackground, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #181825"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.DeepPanelBackground, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="DeepPanelBackground"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="DeepPanelBackground"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="DeepPanelBackground"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Row Surface (Alternating) -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Row Surface (Alternating)" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Subtle tint applied to alternating rows in phrase lists and data grids to improve readability"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.Surface0, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #313244"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.Surface0, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="Surface0"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="Surface0"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="Surface0"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Border / Divider -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Border / Divider" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour of lines, dividers, separator bars, and control outlines throughout the app"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.BorderColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #45475A"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="BorderColor"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="BorderColor"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="BorderColor"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Raised Surface (Cards) -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Raised Surface (Cards)" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Background for elevated elements such as cards, tags, hover highlights, and context menus"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.Surface2, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #585B70"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.Surface2, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="Surface2"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="Surface2"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="Surface2"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- B. Accent -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="ACCENT" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- Accent Color -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Accent Color" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Primary highlight colour. Used for active tabs, primary buttons, focus rings, progress bars, and selected items"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.Accent, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #89B4FA"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="Accent"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="Accent"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="Accent"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Accent Hover / Pressed -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Accent Hover / Pressed" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Accent colour shown when a button or interactive element is hovered or pressed � usually slightly lighter or darker than the base accent"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.AccentHover, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #B4D0FB"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.AccentHover, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="AccentHover"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="AccentHover"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="AccentHover"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- C. Text -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TEXT" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- Primary Text -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Primary Text" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Main body text colour. Used for phrase content, headings, and all primary readable text"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.PrimaryText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #CDD6F4"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.PrimaryText, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="PrimaryText"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="PrimaryText"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="PrimaryText"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Secondary Text -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Secondary Text" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Subdued text for captions, metadata, field labels, timestamps, and secondary descriptions"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.SecondaryText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #A6ADC8"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.SecondaryText, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="SecondaryText"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="SecondaryText"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="SecondaryText"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Muted / Disabled Text -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Muted / Disabled Text" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Low-contrast text for disabled controls, input placeholders, and de-emphasised content"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.MutedText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #6C7086"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="MutedText"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="MutedText"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="MutedText"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Muted Icon Tint -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Muted Icon Tint" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour applied to low-priority icons such as inactive tab icons, secondary action glyphs, and decorative symbols"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.MutedIcon, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #888CC8"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.MutedIcon, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="MutedIcon"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="MutedIcon"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="MutedIcon"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- D. Status -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- Info / Neutral -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Info / Neutral" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour for informational notices, neutral status badges, and general hint messages"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.InfoColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #FAB387"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.InfoColor, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="InfoColor"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="InfoColor"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="InfoColor"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Warning -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Warning" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour for caution messages, unsaved-changes banners, and non-critical configuration alerts"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.Warning, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #F9E2AF"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.Warning, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="Warning"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="Warning"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="Warning"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Error / Danger -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Error / Danger" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour for error messages, failed operations, and destructive action buttons such as Delete"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.ErrorColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #F38BA8"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.ErrorColor, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="ErrorColor"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="ErrorColor"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="ErrorColor"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Error Hover / Pressed -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Error Hover / Pressed" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Error / danger colour when a destructive button is hovered or actively pressed"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.ErrorHover, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #F5A0B5"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.ErrorHover, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="ErrorHover"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="ErrorHover"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="ErrorHover"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Success / Confirmed -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="70"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Success / Confirmed" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Colour for confirmation messages, completed operations, active/connected status, and positive indicators"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.Success, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #A6E3A1"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}" Background="{Binding Theme.Success, Converter={StaticResource HexToBrushConverter}}" Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="Success"/>
                                        <Button Grid.Column="3" Content="Eyedrop" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.PickColorCommand}" CommandParameter="Success"
                                                ToolTip="Open screen eyedropper � hover over anything on screen and click to pick its colour"/>
                                        <Button Grid.Column="4" Content="Reset" Margin="4,0,0,0" Style="{StaticResource ThemeRowButton}" Command="{Binding Theme.ResetColorCommand}" CommandParameter="Success"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- E. Typography -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="TYPOGRAPHY" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- UI Font Family -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="UI Font:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Font family used throughout the settings and main application windows."/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Theme.InstalledFonts}"
                                                  SelectedItem="{Binding Theme.UiFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                                  MaxDropDownHeight="220"
                                                  Style="{StaticResource SettingsComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <!-- Base Font Size -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="UI Font Size:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Base font size (pt) for the UI."/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.BaseFontSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                    </Grid>
                                    <!-- Overlay Font Family -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Overlay Font:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Font family for the overlay input field."/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Theme.InstalledFonts}"
                                                  SelectedItem="{Binding Theme.OverlayFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                                  MaxDropDownHeight="220"
                                                  Style="{StaticResource SettingsComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <!-- Overlay Font Size -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Overlay Font Size:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Font size (pt) for the overlay input field."/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.OverlayFontSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- F. Shape &amp; Density -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="SHAPE &amp; DENSITY" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <!-- Corner Radius -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Corner Radius:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Corner radius applied to buttons, cards, and panels (0 = square, 12 = very rounded)."/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Theme.ThemeCornerRadius, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.ThemeCornerRadius}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0"/>
                                    </Grid>
                                    <!-- Border Thickness / Control Height are intentionally omitted:
                                         the ControlBorderThicknessResource and ControlHeightResource keys
                                         are reserved for future use but are not yet consumed by any control
                                         style, so exposing them would mislead the user. -->
                                    <!-- Spacing Density -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Spacing Density:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Compact = tighter padding; Comfortable = default; Spacious = more breathing room."/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Theme.SpacingDensityValues}"
                                                  SelectedItem="{Binding Theme.SpacingDensity, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource SettingsComboBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- G. Overlay (independent from main window) -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="OVERLAY ONLY" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="These settings apply only to the floating overlay window. Leave colour fields empty to inherit from the main theme."
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <!-- Overlay Background -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Overlay Background" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Background colour of the overlay window. Empty = use Main Window Background."/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.OverlayBackgroundHex, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" FontSize="12" Padding="4,3"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                                                Background="{Binding Theme.OverlayBackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="OverlayBackgroundHex"/>
                                        <Button Grid.Column="3" Content="Reset" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Theme.ResetColorCommand}" CommandParameter="OverlayBackgroundHex"/>
                                    </Grid>
                                    <!-- Overlay Border -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Overlay Border" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Border colour of the overlay window. Empty = use Border / Divider colour."/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.OverlayBorderHex, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" FontSize="12" Padding="4,3"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                                                Background="{Binding Theme.OverlayBorderHex, Converter={StaticResource HexToBrushConverter}}"
                                                Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="OverlayBorderHex"/>
                                        <Button Grid.Column="3" Content="Reset" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Theme.ResetColorCommand}" CommandParameter="OverlayBorderHex"/>
                                    </Grid>
                                    <!-- Status Bar Background -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="90"/><ColumnDefinition Width="28"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Status Bar Background" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Background of the status bar strip at the bottom of the overlay window"/>
                                        <TextBox Grid.Column="1" Text="{Binding Theme.HistoryBackground, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" FontSize="12" Padding="4,3"
                                                 ToolTip="Type a hex colour code, e.g. #14141E"/>
                                        <Button Grid.Column="2" Style="{StaticResource ColorSwatchButton}"
                                                Background="{Binding Theme.HistoryBackground, Converter={StaticResource HexToBrushConverter}}"
                                                Command="{Binding Theme.PickColorDialogCommand}" CommandParameter="HistoryBackground"/>
                                        <Button Grid.Column="3" Content="Reset" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Theme.ResetColorCommand}" CommandParameter="HistoryBackground"
                                                ToolTip="Reset to the default value for this colour"/>
                                    </Grid>
                                    <!-- Overlay Corner Radius -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Corner Radius:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip="Corner rounding of the overlay window border."/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Theme.OverlayCornerRadius, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.OverlayCornerRadius}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- H. Contrast Checker -->
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="CONTRAST (WCAG 2.1)" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Requires =4.5:1 for normal text (AA). Ratios below 3.0 may be difficult to read."
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <!-- Primary on Window -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Primary Text on Window" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Theme.ContrastPrimaryOnWindow, StringFormat={}{0:F2}:1}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.ContrastPrimaryOnWindowStatus}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                   Margin="4,0" Padding="6,2" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Background="{Binding Theme.ContrastPrimaryOnWindowStatus, Converter={StaticResource ContrastStatusToBrushConverter}}"/>
                                    </Grid>
                                    <!-- Primary on Panel -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Primary Text on Panel" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Theme.ContrastPrimaryOnPanel, StringFormat={}{0:F2}:1}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.ContrastPrimaryOnPanelStatus}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                   Margin="4,0" Padding="6,2" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Background="{Binding Theme.ContrastPrimaryOnPanelStatus, Converter={StaticResource ContrastStatusToBrushConverter}}"/>
                                    </Grid>
                                    <!-- Muted on Window -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Muted Text on Window" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Theme.ContrastMutedOnWindow, StringFormat={}{0:F2}:1}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.ContrastMutedOnWindowStatus}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                   Margin="4,0" Padding="6,2" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Background="{Binding Theme.ContrastMutedOnWindowStatus, Converter={StaticResource ContrastStatusToBrushConverter}}"/>
                                    </Grid>
                                    <!-- Accent on Window -->
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Accent on Window" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Theme.ContrastAccentOnWindow, StringFormat={}{0:F2}:1}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Theme.ContrastAccentOnWindowStatus}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                   Margin="4,0" Padding="6,2" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Background="{Binding Theme.ContrastAccentOnWindowStatus, Converter={StaticResource ContrastStatusToBrushConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT: Live preview panel -->
                        <Border Grid.Column="2"
                                Background="{Binding Theme.PanelBackground, Converter={StaticResource HexToBrushConverter}}"
                                BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Preview header bar -->
                                <Border Grid.Row="0"
                                        Background="{Binding Theme.DeepPanelBackground, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="0,0,0,1" Padding="10,6">
                                    <TextBlock Text="LIVE PREVIEW" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"/>
                                </Border>
                                <!-- Scrollable preview content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                                    <StackPanel>

                                        <!-- Mini window mockup -->
                                        <Border Background="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                            <StackPanel>
                                                <!-- Title bar -->
                                                <Border Background="{Binding Theme.PanelBackground, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="0,0,0,1" Padding="8,5" CornerRadius="6,6,0,0">
                                                    <TextBlock Text="App Window"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"/>
                                                </Border>
                                                <!-- Window body -->
                                                <StackPanel Margin="10,8,10,10">
                                                    <!-- Text samples -->
                                                    <TextBlock Text="Primary text &#x2014; main content"
                                                               FontFamily="{Binding Theme.UiFontFamily}"
                                                               FontSize="{Binding Theme.BaseFontSize}"
                                                               Foreground="{Binding Theme.PrimaryText, Converter={StaticResource HexToBrushConverter}}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBlock Text="Secondary label / caption"
                                                               FontFamily="{Binding Theme.UiFontFamily}"
                                                               FontSize="{Binding Theme.BaseFontSize}"
                                                               Foreground="{Binding Theme.SecondaryText, Converter={StaticResource HexToBrushConverter}}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBlock Text="Muted / disabled hint"
                                                               FontFamily="{Binding Theme.UiFontFamily}"
                                                               FontSize="{Binding Theme.BaseFontSize}"
                                                               Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"
                                                               Margin="0,0,0,8"/>
                                                    <!-- Input field -->
                                                    <Border Background="{Binding Theme.DeepPanelBackground, Converter={StaticResource HexToBrushConverter}}"
                                                            BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                            BorderThickness="1"
                                                            CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                            Padding="8,5" Margin="0,0,0,8">
                                                        <TextBlock Text="Text input&#x2026;"
                                                                   FontFamily="{Binding Theme.UiFontFamily}"
                                                                   FontSize="{Binding Theme.BaseFontSize}"
                                                                   Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </Border>
                                                    <!-- Controls — shows Normal / Hover / Disabled states -->
                                                    <TextBlock Text="CONTROLS" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"
                                                               Margin="0,0,0,4"/>
                                                    <!-- Column headers -->
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="52"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto" MinWidth="52"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto" MinWidth="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Normal" FontSize="9" HorizontalAlignment="Center" Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Grid.Column="2" Text="Hover"  FontSize="9" HorizontalAlignment="Center" Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Grid.Column="4" Text="Disabled" FontSize="9" HorizontalAlignment="Center" Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </Grid>
                                                    <!-- Primary button states -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Primary" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{Binding Theme.AccentHover, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Primary" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="4" Background="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"
                                                                Opacity="0.35"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Primary" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Secondary button states -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding Theme.Surface0, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Secondary" FontSize="10" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.PrimaryText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{Binding Theme.Surface2, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Secondary" FontSize="10" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.PrimaryText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="4" Background="{Binding Theme.Surface0, Converter={StaticResource HexToBrushConverter}}"
                                                                Opacity="0.4"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Secondary" FontSize="10" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.PrimaryText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Danger button states -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding Theme.ErrorColor, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Danger" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{Binding Theme.ErrorHover, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Danger" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Grid.Column="4" Background="{Binding Theme.ErrorColor, Converter={StaticResource HexToBrushConverter}}"
                                                                Opacity="0.35"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="{DynamicResource ControlPaddingResource}" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Danger" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Status chips -->
                                                    <TextBlock Text="STATUS BADGES" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"
                                                               Margin="0,0,0,4"/>
                                                    <WrapPanel>
                                                        <Border Background="{Binding Theme.Success, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="6,2" Margin="0,0,4,4">
                                                            <TextBlock Text="Success" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Background="{Binding Theme.Warning, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="6,2" Margin="0,0,4,4">
                                                            <TextBlock Text="Warning" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Background="{Binding Theme.ErrorColor, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="6,2" Margin="0,0,4,4">
                                                            <TextBlock Text="Error" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <Border Background="{Binding Theme.InfoColor, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.ThemeCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="6,2" Margin="0,0,0,4">
                                                            <TextBlock Text="Info" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Overlay snippet (reflects actual OverlayWindow structure) -->
                                        <Border Background="{Binding Theme.OverlayBackgroundHex, Converter={StaticResource HexToBrushConverter}, TargetNullValue=#1E1E2E}"
                                                BorderBrush="{Binding Theme.OverlayBorderHex, Converter={StaticResource HexToBrushConverter}, TargetNullValue=#45475A}"
                                                BorderThickness="1"
                                                CornerRadius="{Binding Theme.OverlayCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                Padding="0"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="OVERLAY" Padding="8,6,8,0"
                                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,4"
                                                           Foreground="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"/>
                                                <!-- Input area -->
                                                <Border Margin="8,0,8,6"
                                                        Background="{Binding Theme.DeepPanelBackground, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderBrush="{Binding Theme.BorderColor, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="1"
                                                        CornerRadius="{Binding Theme.OverlayCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                        Padding="6,4">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Margin="6,0,0,0"
                                                                Background="{Binding Theme.Accent, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="{Binding Theme.OverlayCornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                Padding="6,3">
                                                            <TextBlock Text="Send" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding Theme.WindowBackground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <TextBlock Text="Say something�"
                                                                   FontFamily="{Binding Theme.OverlayFontFamily}"
                                                                   FontSize="{Binding Theme.OverlayFontSize}"
                                                                   Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"
                                                                   VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                                <!-- Status bar -->
                                                <Border Background="{Binding Theme.HistoryBackground, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="0,0,5,5" Padding="8,4">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="?  ?" Margin="4,0,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{Binding Theme.MutedText, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Text="Ready  � 0 chars"
                                                                   FontSize="10"
                                                                   Foreground="{Binding Theme.SecondaryText, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>


        </TabControl>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"
                        Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"/>
                <!-- Import / Export: visible only on Replacements (tab 5) and Phrases (tab 6) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="8,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowImportExport}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="{Binding ImportButtonLabel}" Command="{Binding ImportCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{Binding ExportButtonLabel}" Command="{Binding ExportCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveError}"
                               Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="340"
                               Margin="0,0,12,0"
                               Visibility="{Binding SaveError, Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Phrase regeneration overlay � blocks entire window with progress -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="100"
              Visibility="{Binding IsRegenerating, Converter={StaticResource BoolToVisConverter}}">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}" Opacity="0.92"/>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Regenerating Phrases"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Voice changed � re-generating cached audio."
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding RegenerationStatus}"
                           FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar IsIndeterminate="True"
                             Width="320" Height="4"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"
                             BorderThickness="0"/>
                <TextBlock Text="Please wait � do not close this window."
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
