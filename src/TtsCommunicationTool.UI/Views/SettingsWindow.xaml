<Window x:Class="TtsCommunicationTool.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TtsCommunicationTool.UI.ViewModels"
        xmlns:conv="clr-namespace:TtsCommunicationTool.UI.Converters"
        Title="Settings — The Traveling Star Swirlotl v0.10.0"
        Width="680" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibleConverter"/>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibleConverter"/>
        <conv:HotkeyBindingDisplayConverter x:Key="HotkeyDisplayConverter"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Shared styles for dark-themed controls -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#89B4FA"/>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2B2B3D"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#2B2B3D"/>
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#6C7086"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2B2B3D"
                                            BorderBrush="#45475A"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B4D0FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5A0B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="12,12,12,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#6C7086"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B2B3D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding General.StartWithWindows}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show toast notifications"
                                  IsChecked="{Binding General.ShowNotifications}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <CheckBox Content="Show splash screen on startup"
                                  IsChecked="{Binding General.ShowSplashScreen}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Transcript" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Log spoken messages to transcript file"
                                  IsChecked="{Binding General.EnableTranscriptLogging}"
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <TextBlock Text="Saves every sent message with a timestamp to a plain text file in your AppData folder."
                                   Foreground="#6C7086" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Button Content="Open Transcript File"
                                Command="{Binding General.OpenTranscriptCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Keep unsent text when overlay closes"
                                  IsChecked="{Binding General.KeepOverlayText}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <TextBlock Text="When enabled, any text typed but not sent will be restored the next time you open the overlay."
                                   Foreground="#6C7086" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Show remaining playback time in overlay"
                                  IsChecked="{Binding General.ShowPlaybackTimer}"
                                  ToolTip="Displays a live countdown next to 'Speaking...' in the overlay status bar."
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <TextBlock Text="Shows a countdown timer in the overlay status bar while audio is playing, e.g. 'Speaking...  (45s)'."
                                   Foreground="#6C7086" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Separator Background="#45475A" Margin="0,12,0,12"/>
                        <TextBlock Text="Message Length" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>

                        <CheckBox Content="Limit message length"
                                  IsChecked="{Binding General.EnableCharacterLimit}"
                                  Style="{StaticResource SettingsCheckBox}"/>
                        <Grid Margin="0,4,0,0"
                              IsEnabled="{Binding General.EnableCharacterLimit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum characters:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding General.MaxOverlayInputLength, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                        </Grid>
                        <TextBlock Text="Controls the character limit displayed on the overlay input field. When off, only character count is shown."
                                   Foreground="#6C7086" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>

                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <!-- Diagnostics / Debug Logging                                    -->
                        <!-- ═══════════════════════════════════════════════════════════════ -->
                        <Separator Background="#45475A" Margin="0,12,0,12"/>

                        <Border Background="#1C0F0F"
                                BorderBrush="#F38BA8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>

                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚠" Foreground="#F38BA8" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Diagnostics / Debug Logging"
                                               Foreground="#F38BA8" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Warning text -->
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="#F38BA8" Opacity="0.80"
                                           Margin="0,0,0,10">
                                    These options are for bug hunting and developer diagnostics only.
                                    Leave them all off unless you know exactly what they do.
                                    Some settings may produce large log files or store sensitive content on disk.
                                </TextBlock>

                                <!-- Enable diagnostic logging -->
                                <CheckBox Content="Enable diagnostic logging"
                                          IsChecked="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="#CDD6F4" FontSize="13" Margin="0,4"/>

                                <!-- Verbose logging -->
                                <CheckBox Content="Verbose logging (includes DEBUG events)"
                                          IsChecked="{Binding General.VerboseLogging}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="#CDD6F4" FontSize="13" Margin="0,2"/>

                                <!-- Trace logging -->
                                <CheckBox Content="Trace logging (TRACE and above — very chatty)"
                                          IsChecked="{Binding General.TraceLogging}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="#CDD6F4" FontSize="13" Margin="0,2"/>

                                <!-- Request IDs -->
                                <CheckBox Content="Include request correlation IDs"
                                          IsChecked="{Binding General.IncludeRequestIds}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="#CDD6F4" FontSize="13" Margin="0,2"/>

                                <!-- Raw text — extra warning -->
                                <CheckBox Content="⚠  Log raw spoken text  (UNSAFE)"
                                          IsChecked="{Binding General.LogRawText}"
                                          IsEnabled="{Binding General.EnableDiagnosticLogging}"
                                          Foreground="#F38BA8" FontWeight="SemiBold"
                                          FontSize="13" Margin="0,6,0,2"/>

                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="#F38BA8" Opacity="0.70"
                                           Margin="22,0,0,8">
                                    PRIVACY WARNING: When enabled, the full text of everything you
                                    speak may be written to log files on disk. Only enable this if
                                    you fully understand the privacy implications.
                                </TextBlock>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Open Logs Folder"
                                            Command="{Binding General.OpenLogsFolderCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Delete Old Logs"
                                            Command="{Binding General.DeleteOldLogsCommand}"
                                            Padding="16,8" Cursor="Hand" FontSize="13"
                                            BorderThickness="1" BorderBrush="#F38BA8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="#2E1010"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="Delete Old Logs"
                                                               Foreground="#F38BA8"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#4A1A1A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Click a field, then press the desired key combination. Esc clears a binding. All global hotkeys require at least one modifier key (Ctrl, Alt, Shift, or Win)."
                                   Foreground="#6C7086" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Toggle Overlay:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Global hotkey to open or close the overlay input window from anywhere on your desktop."/>
                            <TextBox Grid.Column="1"
                                     x:Name="OverlayHotkeyBox"
                                     Text="{Binding Hotkeys.OverlayHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Global hotkey to open or close the overlay input window. Click here, then press a key combination."
                                     PreviewKeyDown="OverlayHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop Playback:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Global hotkey to immediately stop any audio currently playing — TTS, phrase, or resend."/>
                            <TextBox Grid.Column="1"
                                     x:Name="StopHotkeyBox"
                                     Text="{Binding Hotkeys.StopHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Global hotkey to immediately stop any audio currently playing. Click here, then press a key combination."
                                     PreviewKeyDown="StopHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Open Settings:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Optional global hotkey to open the Settings window. Leave as (none) to disable. Press Esc to clear."/>
                            <TextBox Grid.Column="1"
                                     x:Name="SettingsHotkeyBox"
                                     Text="{Binding Hotkeys.SettingsHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Optional global hotkey to open the Settings window. Press Esc to clear and leave unbound."
                                     PreviewKeyDown="SettingsHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resend Last:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Optional global hotkey to re-speak the last message without opening the overlay. Leave as (none) to disable."/>
                            <TextBox Grid.Column="1"
                                     x:Name="ResendHotkeyBox"
                                     Text="{Binding Hotkeys.ResendHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Optional global hotkey to re-speak your last spoken message. Press Esc to clear and leave unbound."
                                     PreviewKeyDown="ResendHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <!-- Separator -->
                        <Separator Margin="0,4,0,12" Background="#45475A"/>

                        <TextBlock Text="Overlay Shortcuts" Style="{StaticResource SectionHeader}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6C7086" Margin="0,0,0,12"
                                   Text="These shortcuts are only active while the overlay input window is open. They do not require global hotkey registration."/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop + Send:" Style="{StaticResource FieldLabel}"
                                       ToolTip="While the overlay is open: immediately stops any audio that is currently playing, then sends the text you have typed. Default is Ctrl+Enter."/>
                            <TextBox Grid.Column="1"
                                     x:Name="OverrideHotkeyBox"
                                     Text="{Binding Hotkeys.OverrideHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Overlay-only shortcut: stops current audio and immediately sends your overlay text. Default: Ctrl+Enter. Press Esc to clear."
                                     PreviewKeyDown="OverrideHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"/>
                        </Grid>

                        <TextBlock Text="{Binding Hotkeys.ValidationMessage}"
                                   Foreground="#F38BA8" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Audio Devices" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor (You):" Style="{StaticResource FieldLabel}"
                                       ToolTip="The audio device you hear yourself on. Usually your headphones or speakers."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedMonitorDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The audio device you hear yourself on (headphones, speakers, etc.). All TTS, phrases, and UI sounds play here."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary (App):" Style="{StaticResource FieldLabel}"
                                       ToolTip="The virtual audio device routed into Discord, VRChat, or other voice apps. Usually VB-Cable or a similar virtual cable."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Audio.OutputDevices}"
                                      SelectedValue="{Binding Audio.SelectedSecondaryDeviceId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FriendlyName"
                                      ToolTip="The secondary output device routed to Discord/VRChat (e.g. VB-Cable). Only TTS speech and phrase audio are sent here. UI sounds play on the monitor device only."
                                      Style="{StaticResource SettingsComboBox}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Test Monitor" Command="{Binding Audio.TestMonitorCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Secondary" Command="{Binding Audio.TestSecondaryCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Test Both" Command="{Binding Audio.TestBothCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="↻ Refresh" Command="{Binding Audio.RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Audio.DeviceWarning}"
                                   Foreground="#FAB387" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="Volume" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>

                        <!-- Monitor Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                       ToolTip="Volume you hear in your own headphones/speakers."/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.MonitorVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip="Volume of TTS and phrase audio in your own monitor device."/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="#CDD6F4" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.MonitorVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Secondary Volume -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                       ToolTip="Volume sent to the secondary voice device (Discord/VRChat)."/>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Audio.SecondaryVolume}"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTip="Volume of TTS and phrase audio sent to the secondary voice device. UI sounds are never routed here."/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="#CDD6F4" FontSize="12"
                                       Margin="6,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}%">
                                        <Binding Path="Audio.SecondaryVolume"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- Audio routing note -->
                        <Border Background="#1E1E2E" BorderBrush="#45475A" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ Audio Routing" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="12"
                                           Text="Only TTS speech and phrase audio are sent to the secondary (app) device. Any non-voice sounds such as UI feedback or error tones play on the monitor device only and will not be heard in Discord or VRChat."/>
                            </StackPanel>
                        </Border>

                        <!-- Trailing Silence -->
                        <Separator Background="#45475A" Margin="0,16,0,12"/>
                        <TextBlock Text="Trailing Silence" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                        <Border Background="#1C1200" BorderBrush="#FAB387" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" Foreground="#FAB387" FontSize="12"
                                       Text="⚠  Trimming too aggressively may clip the last word of a sentence. Start with a high retention value (80–95%) and reduce gradually."/>
                        </Border>

                        <CheckBox Content="Trim trailing silence from generated audio"
                                  IsChecked="{Binding Audio.TrimTrailingSilence}"
                                  ToolTip="Removes silence at the end of each generated audio clip so playback ends sooner."
                                  Style="{StaticResource SettingsCheckBox}"/>

                        <Grid Margin="0,8,0,4"
                              IsEnabled="{Binding Audio.TrimTrailingSilence}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="5" Maximum="100" TickFrequency="5"
                                    Value="{Binding Audio.SilenceRetentionPercent}"
                                    VerticalAlignment="Center"
                                    ToolTip="How much trailing silence to keep after trimming. 100% keeps all silence; 5% keeps almost none."/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Audio.SilenceRetentionDisplay}"
                                       Foreground="#CDD6F4" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Silence retention  (5% = most trimmed, 100% = off)"
                                   Foreground="#6C7086" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="Only applies to real-time TTS output. Cached phrase audio is not trimmed."
                                   Foreground="#6C7086" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Voice Tab -->
            <TabItem Header="Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Voice Engine" Style="{StaticResource SectionHeader}"/>

                        <!-- Engine selector -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="Kokoro (Offline)"
                                         Foreground="#CDD6F4" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsKokoro, Mode=TwoWay}"
                                         Margin="0,0,16,0"
                                         ToolTip="Kokoro is a local, fully offline TTS engine. No internet or API key required. Voice models are bundled with the app."/>
                            <RadioButton Content="ElevenLabs (Online)"
                                         Foreground="#CDD6F4" GroupName="EngineGroup"
                                         IsChecked="{Binding Voice.IsElevenLabs, Mode=TwoWay}"
                                         ToolTip="ElevenLabs is a cloud TTS engine. Requires an internet connection and a valid ElevenLabs API key."/>
                        </StackPanel>

                        <!-- ── Kokoro section ───────────────── -->
                        <StackPanel Visibility="{Binding Voice.IsKokoro, Converter={StaticResource BoolToVisConverter}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The Kokoro voice model to use for speech generation."/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.AvailableVoices}"
                                          SelectedValue="{Binding Voice.SelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="Select the Kokoro voice model to use for speech generation."/>
                            </Grid>
                        </StackPanel>

                        <!-- ── ElevenLabs section ───────────── -->
                        <StackPanel Visibility="{Binding Voice.IsElevenLabs, Converter={StaticResource BoolToVisConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key:" Style="{StaticResource FieldLabel}"
                                           ToolTip="Your ElevenLabs API key. Found in your ElevenLabs account settings at elevenlabs.io."/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Voice.ElevenLabsApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"
                                         ToolTip="Your ElevenLabs API key. Required for online voice generation."/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The ElevenLabs model ID to use (e.g. eleven_multilingual_v2, eleven_turbo_v2). See ElevenLabs docs for available model IDs."/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Voice.ElevenLabsModelId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"
                                         ToolTip="ElevenLabs model ID. Common values: eleven_multilingual_v2, eleven_turbo_v2."/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Fetch Voices"
                                        Command="{Binding Voice.FetchElevenLabsVoicesCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        ToolTip="Download the list of voices available to your ElevenLabs account."/>
                                <TextBlock Text="{Binding Voice.ElevenLabsStatus}"
                                           Foreground="#89B4FA" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Voice:" Style="{StaticResource FieldLabel}"
                                           ToolTip="The ElevenLabs voice to use. Click Fetch Voices first if this list is empty."/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Voice.ElevenLabsVoices}"
                                          SelectedValue="{Binding Voice.ElevenLabsSelectedVoiceId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="Select the ElevenLabs voice to use for speech generation. Use Fetch Voices to populate this list."/>
                            </Grid>
                        </StackPanel>

                        <!-- Global Pitch (both engines) -->
                        <TextBlock Text="Global Pitch" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#6C7086" Margin="0,0,0,12"
                                   Text="Adjusts the pitch of all standard TTS output. Changes apply immediately so you can hear the effect before saving. Cached phrases are unaffected."/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pitch:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Pitch multiplier applied to real-time TTS output. 1.0 = normal pitch. 0.5 = lower/slower. 2.0 = higher/faster. Use Test Voice to preview."/>
                            <Slider Grid.Column="1"
                                    Minimum="0.5" Maximum="2.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Voice.GlobalPitch, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTip="Drag to adjust pitch. 1.0 = normal. Changes are previewed immediately; press Cancel to revert."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Voice.GlobalPitchPercent}"
                                       Foreground="#CDD6F4"
                                       VerticalAlignment="Center"
                                       ToolTip="Current pitch value as a percentage of normal."/>
                        </Grid>

                        <!-- Test Voice (both engines) -->
                        <Button Content="Test Voice" Command="{Binding Voice.TestVoiceCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                ToolTip="Speak a sample phrase using the current engine, voice, and pitch settings."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Overlay Appearance" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Width:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Width of the overlay input window in pixels."/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"
                                     ToolTip="Width of the overlay input window in pixels."/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Height:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Height of the overlay input window in pixels."/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.OverlayHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"
                                     ToolTip="Height of the overlay input window in pixels."/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font Size:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Font size of the text input field inside the overlay window."/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Appearance.FontSize, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"
                                     ToolTip="Font size (points) of the input field inside the overlay window."/>
                        </Grid>

                        <!-- Overlay transparency slider (0.20 = see-through, 0.95 = opaque) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transparency:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Background opacity of the overlay window."/>
                            <Slider Grid.Column="1"
                                    Minimum="0.20" Maximum="0.95"
                                    Value="{Binding Appearance.OverlayOpacity, UpdateSourceTrigger=PropertyChanged}"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ToolTip="Background opacity of the overlay."/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Appearance.OverlayOpacity, StringFormat={}{0:P0}}"
                                       Foreground="#A6ADC8" FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Overlay font family dropdown -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font Type:" Style="{StaticResource FieldLabel}"
                                       ToolTip="Font used in the overlay text input."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Appearance.InstalledFonts}"
                                      SelectedItem="{Binding Appearance.OverlayFontFamily, UpdateSourceTrigger=PropertyChanged}"
                                      MaxDropDownHeight="240"
                                      Style="{StaticResource SettingsComboBox}"
                                      ToolTip="Font family used in the overlay text input field.">
                                <!-- Each font name rendered in its own typeface for quick visual preview.
                                     WPF's built-in FontFamilyConverter converts the string automatically. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{Binding}"
                                                   FontSize="17"
                                                   Foreground="#CDD6F4"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Reset Overlay Position"
                                    Command="{Binding ResetOverlayPositionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Clears the saved overlay position so it opens centred on screen next time."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Replacements Tab -->
            <TabItem Header="Replacements">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Text Replacements" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Global enable toggle -->
                    <CheckBox Grid.Row="1"
                              Content="Enable text replacements"
                              IsChecked="{Binding TextReplacements.IsEnabled}"
                              Foreground="#CDD6F4"
                              Margin="8,8,8,8"/>

                    <!-- Rules DataGrid -->
                    <DataGrid x:Name="ReplacementsGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding TextReplacements.Rules}"
                              SelectedItem="{Binding TextReplacements.SelectedRule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              Background="#2B2B3D"
                              Foreground="#CDD6F4"
                              BorderBrush="#45475A"
                              BorderThickness="1"
                              RowBackground="#2B2B3D"
                              AlternatingRowBackground="#313145"
                              HorizontalGridLinesBrush="#45475A"
                              VerticalGridLinesBrush="#45475A"
                              AllowDrop="True"
                              Margin="8,0"
                              PreviewMouseLeftButtonDown="ReplacementsGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ReplacementsGrid_PreviewMouseMove"
                              DragOver="ReplacementsGrid_DragOver"
                              DragLeave="ReplacementsGrid_DragLeave"
                              Drop="ReplacementsGrid_Drop"
                              CurrentCellChanged="ReplacementsGrid_CurrentCellChanged"
                              PreparingCellForEdit="ReplacementsGrid_PreparingCellForEdit">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="#45475A"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3A4060"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="#2E3D6A"/>
                                        <Setter Property="BorderBrush" Value="#89B4FA"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3B3B55"/>
                                    </Trigger>
                                    <!-- New/empty rows get a tinted indicator so users know they can click in -->
                                    <DataTrigger Binding="{Binding TriggerText}" Value="">
                                        <Setter Property="Background" Value="#1A2540"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="36"/>

                            <!-- Trigger column — filled rows blend in as plain text; empty (new) rows show input border -->
                            <DataGridTemplateColumn Header="Trigger  ✎" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CellBorder"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="3" Margin="2,1" Padding="5,3"
                                                Cursor="IBeam" ToolTip="Click to edit">
                                            <TextBlock Text="{Binding TriggerText}" Foreground="#CDD6F4" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Empty/new rows get input-box styling so the clickable area is obvious -->
                                            <DataTrigger Binding="{Binding TriggerText}" Value="">
                                                <Setter TargetName="CellBorder" Property="Background" Value="#252540"/>
                                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#45475A"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TriggerText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#313145" Foreground="#CDD6F4"
                                                 BorderBrush="#89B4FA" BorderThickness="1"
                                                 CaretBrush="#CDD6F4" Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Replacement column — same treatment -->
                            <DataGridTemplateColumn Header="Replacement  ✎" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CellBorder"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="3" Margin="2,1" Padding="5,3"
                                                Cursor="IBeam" ToolTip="Click to edit">
                                            <TextBlock Text="{Binding ReplacementText}" Foreground="#CDD6F4" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Empty/new rows get input-box styling so the clickable area is obvious -->
                                            <DataTrigger Binding="{Binding ReplacementText}" Value="">
                                                <Setter TargetName="CellBorder" Property="Background" Value="#252540"/>
                                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#45475A"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#313145" Foreground="#CDD6F4"
                                                 BorderBrush="#89B4FA" BorderThickness="1"
                                                 CaretBrush="#CDD6F4" Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="Case" Binding="{Binding IsCaseSensitive, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                            <DataGridCheckBoxColumn Header="Word" Binding="{Binding WholeWordOnly, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action buttons - primary actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,8,8,2">
                        <Button Content="Add" Command="{Binding TextReplacements.AddCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding TextReplacements.DeleteCommand}"
                                Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                        <Button Content="▲ Up" Command="{Binding TextReplacements.MoveUpCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="▼ Down" Command="{Binding TextReplacements.MoveDownCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <!-- Import / Export on their own row so the button bar stays uncluttered -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,0,8,2">
                        <Button Content="Import..." Command="{Binding TextReplacements.ImportCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Export..." Command="{Binding TextReplacements.ExportCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="{Binding TextReplacements.StatusMessage}"
                               Foreground="#A6E3A1" FontSize="12"
                               Visibility="{Binding TextReplacements.StatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                               Margin="8,2,8,2" TextWrapping="Wrap"/>

                    <!-- How it works — 2-column reference panel -->
                    <Border Grid.Row="6"
                            Background="#1A1A2E"
                            BorderBrush="#3A3A5C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="8,4,8,8"
                            Padding="0"
                            MaxHeight="340">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: How it works + ELI5 example -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Foreground="#89B4FA" FontSize="13" FontWeight="Bold" Margin="0,0,0,5">How text replacements work</TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,6">
                                        <Run Foreground="#A6ADC8">Text replacements are rules that say: </Run>
                                        <Run Foreground="#CDD6F4" FontWeight="Bold">&#x201C;When I type this, replace it with that.&#x201D;</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,4">
                                        <Run Foreground="#A6ADC8">The app checks rules </Run>
                                        <Run Foreground="#CDD6F4" FontWeight="Bold">top to bottom</Run>
                                        <Run Foreground="#A6ADC8">. The </Run>
                                        <Run Foreground="#CDD6F4" FontWeight="Bold">first matching rule wins</Run>
                                        <Run Foreground="#A6ADC8"> &#x2014; rules below it are skipped for that match.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,12">
                                        <Run Foreground="#A6E3A1" FontWeight="SemiBold">Tip: </Run>
                                        <Run Foreground="#A6ADC8">Put more specific triggers above shorter or broader ones.</Run>
                                    </TextBlock>

                                    <Border Height="1" Background="#3A3A5C" Margin="0,0,0,10"/>

                                    <TextBlock Foreground="#89B4FA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6">ELI5 example</TextBlock>

                                    <!-- Settings context for this example -->
                                    <TextBlock Foreground="#CDD6F4" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3">Settings used in this example</TextBlock>
                                    <Border Background="#252540" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="#A6ADC8">&#x2022; <Run FontFamily="Consolas" Foreground="#CDD6F4">omw</Run> has <Run Foreground="#CDD6F4" FontWeight="SemiBold">Word</Run> turned ON.</TextBlock>
                                            <TextBlock FontSize="11" Foreground="#A6ADC8">&#x2022; <Run FontFamily="Consolas" Foreground="#CDD6F4">w</Run> does <Run Foreground="#F38BA8" FontWeight="SemiBold">not</Run> have <Run Foreground="#CDD6F4" FontWeight="SemiBold">Word</Run> turned on.</TextBlock>
                                            <TextBlock FontSize="11" Foreground="#A6ADC8" Margin="0,1,0,0">&#x2022; Neither rule has <Run Foreground="#CDD6F4" FontWeight="SemiBold">Case</Run> turned on.</TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Good order -->
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3">Rules in this order:</TextBlock>
                                    <Border Background="#1A2E1A" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">1. omw &#x2192; on my way</TextBlock>
                                            <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">2. w &#x2192; with</TextBlock>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Foreground="#A6ADC8">Typing </Run>
                                                <Run Foreground="#CDD6F4" FontFamily="Consolas">omw w snacks</Run>
                                                <Run Foreground="#A6ADC8"> &#x2192; </Run>
                                                <Run Foreground="#A6E3A1" FontFamily="Consolas">on my way with snacks</Run>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                                <Run Foreground="#A6E3A1">&#x2714; Good order.</Run>
                                                <Run Foreground="#A6ADC8"> Specific rule wins first.</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bad order -->
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3">But if flipped:</TextBlock>
                                    <Border Background="#2E1A1A" CornerRadius="3" Padding="8,5" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">1. w &#x2192; with</TextBlock>
                                            <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">2. omw &#x2192; on my way</TextBlock>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Foreground="#A6ADC8">Typing </Run>
                                                <Run Foreground="#CDD6F4" FontFamily="Consolas">omw w snacks</Run>
                                                <Run Foreground="#A6ADC8"> could become </Run>
                                                <Run Foreground="#F38BA8" FontFamily="Consolas">omwith with snacks</Run>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                                <Run Foreground="#F38BA8">&#x2718; Oops.</Run>
                                                <Run Foreground="#A6ADC8"> The </Run>
                                                <Run FontFamily="Consolas" Foreground="#A6ADC8">w</Run>
                                                <Run Foreground="#A6ADC8"> inside </Run>
                                                <Run FontFamily="Consolas" Foreground="#A6ADC8">omw</Run>
                                                <Run Foreground="#A6ADC8"> was matched first.</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="#3A3A5C" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Foreground="#A6E3A1">&#x25B8; </Run><Run Foreground="#A6ADC8">Put longer, more specific triggers near the top.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Foreground="#A6E3A1">&#x25B8; </Run><Run Foreground="#A6ADC8">Put shorter, more general triggers lower down.</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Foreground="#A6E3A1">&#x25B8; </Run>
                                        <Run Foreground="#A6ADC8">Use </Run>
                                        <Run Foreground="#A6ADC8" FontWeight="Bold">Word</Run>
                                        <Run Foreground="#A6ADC8"> for short triggers when you only want whole-word matches.</Run>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Background="#3A3A5C" Margin="0,4,0,4"/>

                                <!-- RIGHT: Settings key -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Foreground="#89B4FA" FontSize="13" FontWeight="Bold" Margin="0,0,0,5">Settings key</TextBlock>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Enable text replacements</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">Turns the whole feature on or off. If off, no replacements happen regardless of individual row settings.</TextBlock>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">On (per row)</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">Enables or disables one specific rule. Other rules are unaffected.</TextBlock>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Trigger</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">The text the app looks for. Example:</TextBlock>
                                    <Border Background="#252540" CornerRadius="3" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">brb</TextBlock>
                                    </Border>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Replacement</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">The text that replaces the trigger. Example:</TextBlock>
                                    <Border Background="#252540" CornerRadius="3" Padding="6,2" Margin="0,0,0,2" HorizontalAlignment="Left">
                                        <TextBlock Foreground="#CDD6F4" FontSize="11" FontFamily="Consolas">be right back</TextBlock>
                                    </Border>
                                    <TextBlock FontSize="11" Margin="0,0,0,8">
                                        <Run Foreground="#A6ADC8">So: </Run>
                                        <Run Foreground="#CDD6F4" FontFamily="Consolas">brb</Run>
                                        <Run Foreground="#A6ADC8"> &#x2192; </Run>
                                        <Run Foreground="#CDD6F4" FontFamily="Consolas">be right back</Run>
                                    </TextBlock>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Case</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">
                                        <Run FontWeight="SemiBold">On:</Run> trigger must match capitalization exactly. <Run FontFamily="Consolas">brb</Run> &#x2260; <Run FontFamily="Consolas">BRB</Run> &#x2260; <Run FontFamily="Consolas">Brb</Run>
                                    </TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8">
                                        <Run FontWeight="SemiBold">Off:</Run> capitalization doesn&#x2019;t have to match. All variants trigger the same rule.
                                    </TextBlock>

                                    <TextBlock Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1">Word</TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,2">
                                        <Run FontWeight="SemiBold">On:</Run> trigger only fires when it&#x2019;s a whole word. <Run FontFamily="Consolas">cat</Run> matches <Run FontFamily="Consolas">cat</Run> but not <Run FontFamily="Consolas">catalog</Run>.
                                    </TextBlock>
                                    <TextBlock Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,4">
                                        <Run FontWeight="SemiBold">Off:</Run> trigger can match inside a longer word.
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="16">
                                        <Run Foreground="#F9E2AF" FontWeight="SemiBold">Careful: </Run>
                                        <Run Foreground="#A6ADC8">Short triggers with Word OFF can cause surprising matches inside longer words.</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>            <!-- Phrases Tab -->
            <TabItem Header="Phrases">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0: title -->
                        <RowDefinition Height="Auto"/>  <!-- 1: search bar -->
                        <RowDefinition Height="*"/>     <!-- 2: list (ListView+GridView has native headers) -->
                        <RowDefinition Height="Auto"/>  <!-- 3: controls -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="Quick Phrases" Style="{StaticResource SectionHeader}" Margin="8,0"/>

                    <!-- Search / filter bar -->
                    <Grid Grid.Row="1" Margin="8,6,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search box -->
                        <Grid Margin="0,0,6,0">
                            <TextBox Text="{Binding Phrases.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <TextBlock Text="Search phrases..."
                                       Foreground="#6C7086" FontSize="12"
                                       IsHitTestVisible="False"
                                       Margin="10,7,0,0"
                                       Visibility="{Binding Phrases.FilterText, Converter={StaticResource EmptyToVisibleConverter}}"/>
                        </Grid>

                        <!-- Category filter -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Phrases.Categories}"
                                  SelectedItem="{Binding Phrases.SelectedCategory}"
                                  Margin="0,0,6,0"
                                  Style="{StaticResource SettingsComboBox}"/>

                        <!-- Favorites toggle -->
                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding Phrases.ShowFavoritesOnly}"
                                      Padding="10,5"
                                      Background="#2B2B3D"
                                      Foreground="#CDD6F4"
                                      BorderBrush="#45475A"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      ToolTip="Show favorites only">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#2B2B3D"/>
                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                    <Setter Property="BorderBrush" Value="#45475A"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <!-- ControlTemplate required so WPF system theme cannot override colours -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#89B4FA"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#89B4FA"/>
                                                        <Setter Property="Foreground" Value="#1E1E2E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#3B3B55"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsChecked" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bg" Property="Background" Value="#A6C8FF"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#A6C8FF"/>
                                                        <Setter Property="Foreground" Value="#1E1E2E"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="&#x2605; Favorites" FontSize="12"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Phrase list -->
                    <ListView x:Name="PhraseListView"
                              Grid.Row="2"
                              GridViewColumnHeader.Click="PhraseSort_Click"
                              SizeChanged="PhraseListView_SizeChanged"
                              ItemsSource="{Binding Phrases.FilteredPhrases}"
                              SelectedItem="{Binding Phrases.SelectedPhrase}"
                              Background="#2B2B3D"
                              Foreground="#CDD6F4"
                              BorderBrush="#45475A"
                              Margin="8,4,8,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Tag tunnels window DataContext into the ContextMenu (lives outside visual tree) -->
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="#2B2B3D" BorderBrush="#45475A" BorderThickness="1">
                                            <ContextMenu.Resources>
                                                <!-- ControlTemplate on ContextMenu itself — WPF default popup chrome renders white otherwise -->
                                                <Style TargetType="ContextMenu">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContextMenu">
                                                                <Border Background="#2B2B3D"
                                                                        BorderBrush="#45475A"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="0,3">
                                                                    <StackPanel IsItemsHost="True"
                                                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <!-- Full ControlTemplate required — WPF defaults ignore Background without it -->
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Background" Value="#2B2B3D"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Padding" Value="22,7,18,7"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="MenuItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter ContentSource="Header"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                                                      RecognizesAccessKey="True"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Foreground" Value="#6C7086"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style TargetType="Separator">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Separator">
                                                                <Border Height="1" Background="#45475A" Margin="6,3"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ContextMenu.Resources>
                                            <!-- PlacementTarget = the ListBoxItem; Tag on it = window DataContext; DataContext on it = PhraseItem -->
                                            <MenuItem Header="Toggle Favorite"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.ToggleFavoriteByItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Toggle Pin"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.TogglePinnedByItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator Background="#45475A"/>
                                            <MenuItem Header="Delete"
                                                      Command="{Binding Path=PlacementTarget.Tag.Phrases.DeleteCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#45475A"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3B3B55"/>
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <!-- Dark-themed column header style shared by all 5 columns -->
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#1E1E2E"/>
                                        <Setter Property="Foreground" Value="#E0E8FF"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#45475A"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="4,6"/>
                                        <Setter Property="MinHeight" Value="34"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2B2B3D"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3B3B55"/>
                                                        </Trigger>
                                                        <Trigger Property="Role" Value="Padding">
                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#1E1E2E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <!-- col 0: ★ Favorite — sortable -->
                                <GridViewColumn Header="&#x2605;" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#x2605;"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                                      Path=DataContext.Phrases.ToggleFavoriteByItemCommand}"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Toggle favorite"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="1"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Foreground" Value="#45475A"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Foreground" Value="#F9E2AF"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#8899AA"/>
                                                            </Trigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFavorite}" Value="True"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#FFD966"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 1: 📌 Pin — not sortable -->
                                <GridViewColumn Header="&#x1F4CC;" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#x1F4CC;"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                                                      Path=DataContext.Phrases.TogglePinnedByItemCommand}"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Toggle pin"
                                                    Focusable="False">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="1"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 2: Name &amp; Text — sortable, auto-fill width -->
                                <GridViewColumn Header="Name &amp; Text  &#x21C5;" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2,4,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#CDD6F4"/>
                                                <TextBlock Text="{Binding Text}" Foreground="#6C7086" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 3: Category — sortable -->
                                <GridViewColumn Header="Category  &#x21C5;" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#CBA6F7" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- col 4: Hotkey — not sortable -->
                                <GridViewColumn Header="Hotkey" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Hotkey, Converter={StaticResource HotkeyDisplayConverter}}"
                                                       Foreground="#89B4FA" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Add/Delete/Play controls -->
                    <StackPanel Grid.Row="3" Margin="8,12,8,0">
                        <!-- Input row: name, text, category -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,4,0">
                                <TextBox x:Name="PhraseNameBox"
                                         Text="{Binding Phrases.EditName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Phrase name..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditName, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="1" Margin="4,0,4,0">
                                <TextBox x:Name="PhraseTextBox"
                                         Text="{Binding Phrases.EditText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Phrase text..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditText, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,0,0">
                                <TextBox Text="{Binding Phrases.EditCategory, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBox}"/>
                                <TextBlock Text="Category..."
                                           Foreground="#6C7086" FontSize="13"
                                           IsHitTestVisible="False"
                                           Margin="10,7,0,0"
                                           Visibility="{Binding Phrases.EditCategory, Converter={StaticResource EmptyToVisibleConverter}}"/>
                            </Grid>
                        </Grid>
                        <!-- Primary actions row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Add" Command="{Binding Phrases.AddCommand}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                            <Button Content="Update" Command="{Binding Phrases.UpdateCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Save changes to the selected phrase"/>
                            <Button Content="Delete" Command="{Binding Phrases.DeleteCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                            <Button Content="▶ Play" Command="{Binding Phrases.PlayCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <!--
                            <Button Content="★ Fav" Command="{Binding Phrases.ToggleFavoriteCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Toggle favorite on selected phrase"/>
                            <Button Content="📌 Pin" Command="{Binding Phrases.TogglePinnedCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Toggle pin on selected phrase"/>
                            -->
                        </StackPanel>
                        <!-- Import / Export on their own row so the button bar stays uncluttered -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Import..." Command="{Binding Phrases.ImportCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Export..." Command="{Binding Phrases.ExportCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Phrases.PhraseStatusMessage}"
                                   Foreground="#A6E3A1" FontSize="12"
                                   Visibility="{Binding Phrases.PhraseStatusMessage, Converter={StaticResource NonEmptyToVisibleConverter}}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <!-- Hotkey assignment for selected phrase -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding Phrases.SelectedPhrase, Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hotkey:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     x:Name="PhraseHotkeyBox"
                                     Text="{Binding Phrases.SelectedPhraseHotkeyDisplay, Mode=OneWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     PreviewKeyDown="PhraseHotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus"
                                     LostFocus="HotkeyBox_LostFocus"
                                     Margin="8,0"/>
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Command="{Binding Phrases.ClearHotkeyCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>


        </TabControl>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                Background="#2B2B3D"
                BorderBrush="#45475A"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"
                        Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveError}"
                               Foreground="#F38BA8" FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="340"
                               Margin="0,0,12,0"
                               Visibility="{Binding SaveError, Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Phrase regeneration overlay — blocks entire window with progress -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="100"
              Visibility="{Binding IsRegenerating, Converter={StaticResource BoolToVisConverter}}">
            <Grid.Background>
                <SolidColorBrush Color="#1E1E2E" Opacity="0.92"/>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Regenerating Phrases"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#89B4FA"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Voice changed — re-generating cached audio."
                           FontSize="12" Foreground="#A6ADC8"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding RegenerationStatus}"
                           FontSize="14" Foreground="#CDD6F4"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar IsIndeterminate="True"
                             Width="320" Height="4"
                             Foreground="#89B4FA" Background="#45475A"
                             BorderThickness="0"/>
                <TextBlock Text="Please wait — do not close this window."
                           FontSize="11" Foreground="#6C7086"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
