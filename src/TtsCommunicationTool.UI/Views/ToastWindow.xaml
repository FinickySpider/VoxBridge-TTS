<Window x:Class="TtsCommunicationTool.UI.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="340"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False">

    <Border x:Name="ToastBorder"
            Background="#E6313244"
            CornerRadius="10"
            BorderBrush="#45475A"
            BorderThickness="1"
            Margin="8"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.4" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="IconBlock"
                       Grid.Column="0"
                       FontSize="18"
                       VerticalAlignment="Top"
                       Margin="0,0,10,0"/>

            <!-- Message -->
            <TextBlock x:Name="MessageBlock"
                       Grid.Column="1"
                       Foreground="#CDD6F4"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
