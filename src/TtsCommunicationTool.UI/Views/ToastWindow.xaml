<Window x:Class="TtsCommunicationTool.UI.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False">

    <!-- Outer margin creates shadow gutter -->
    <Border x:Name="ToastBorder"
            CornerRadius="10"
            BorderBrush="#55585E"
            BorderThickness="1"
            Margin="8"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" Opacity="0.55" ShadowDepth="3"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Colored accent strip -->
                <ColumnDefinition Width="5"/>
                <!-- Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left accent bar -->
            <Border x:Name="AccentBar" Grid.Column="0" Background="{DynamicResource AccentBrush}"/>

            <!-- Content panel -->
            <Border x:Name="ContentPanel"
                    Grid.Column="1"
                    Background="#E8202030"
                    Padding="14,14,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock x:Name="IconBlock"
                               Grid.Column="0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,1,11,0"/>

                    <!-- Message -->
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleBlock"
                                   Foreground="#FFFFFF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,3"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="MessageBlock"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   LineHeight="18"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
